# Geländetypen (Meilenstein M1).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.2.
#   ertrag         – Faktor auf die Produktion aller Berufsgruppen eines Ortes
#   tragfaehigkeit – Einwohner je km², die die Landwirtschaft der Zeit ernähren kann (seit M4,
#                    docs/technik/bevoelkerung.md, Abschnitt 4.1); Städte mal tragfaehigkeit_stadt
#
# Die Faktoren sind Spielwerte. Sie bilden grob die naturräumliche Ausstattung
# Mittel- und Nordostdeutschlands um 1650 ab: fruchtbare Lössbörden und
# Flussauen, magere Sandböden in Heide und Fläming, ungeteilte Bruchländer vor
# den Trockenlegungen des 18. Jahrhunderts. Farben für den Kartenmodus "Gelände".
#
# Seit Meilenstein M3 (Karte des Kernraums) zusätzlich "hochgebirge" für die Alpen;
# die Gelände der neuen Orte leitet tools/geodaten/orte.py aus dem Höhenmodell ab.
#
# Tragfähigkeit (seit M4, Spielwert): etwa das 1,8-Fache der ländlichen Dichte von 1648 in den
# Orten mit Daten (10–33 Einwohner je km² nach dem Dreißigjährigen Krieg), also ungefähr die
# Dichte vor dem Krieg mit Reserve. Damit wächst die Bevölkerung nach 1648 rasch und flacht im
# 18. Jahrhundert ab; Agrartechnik (Kartoffel, Agrarreformen) hebt die Werte später.

gelaende flussaue {
    name           = "Flussaue"
    farbe          = { 128 160 112 }
    ertrag         = 1.15
    tragfaehigkeit = 45
}

