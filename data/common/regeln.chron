# Globale Regeln und Balancing-Werte (Meilenstein M1, Bevölkerung seit M4, Wirtschaft seit M5).
#
# Format und Formeln: docs/technik/chronik-skript.md, Abschnitte 3.1 und 5, sowie
# docs/technik/bevoelkerung.md, Abschnitt 4, und docs/technik/wirtschaft.md, Abschnitt 4. Alle Felder sind Pflicht. Raten sind Jahreswerte.

regeln {
    verwuestung_abbau     = 0.03    # jährlicher relativer Abbau der Verwüstung
    verwuestung_ertrag    = 0.5     # Produktionsverlust je Verwüstungsgrad
    seuche_chance         = 0.01    # jährlich je Ort
    seuche_verlust_min    = 0.04    # Bevölkerungsverlust bei einer Seuche, Untergrenze
    seuche_verlust_max    = 0.12    # … Obergrenze
    steuersatz_max        = 0.5     # höchster erlaubter Steuersatz

    # ─── Bevölkerung (seit M4) ───────────────────────────────────────────────
    # Startwerte aus docs/technik/bevoelkerung.md, Abschnitt 4.9 (Sicherheit: spielwert).
    # Größenordnungen der Frühen Neuzeit: Geburtenrate 35–42 ‰, Sterberate 30–36 ‰, Kinder unter
    # 15 Jahren etwa ein Drittel der Bevölkerung.

    # Altersaufbau beim Start (der Rest sind die Alten, 65+)
    anteil_kinder             = 0.34    # 0–14 Jahre
    anteil_jung               = 0.26    # 15–29
    anteil_erwerb             = 0.33    # 30–64

    # Geburten
    fruchtbarkeit             = 0.093   # Geburten je Person im fruchtbaren Alter und Jahr
    anteil_fruchtbar_erwerb   = 0.4     # Anteil der 30–64-Jährigen im fruchtbaren Alter
    fruchtbarkeit_landreserve = 0.3     # Zuschlag bei voller Landreserve (freie Höfe, frühe Heirat)
    fruchtbarkeit_wohlstand   = 0.15    # Zu-/Abschlag je 50 Punkte Lebensstandard

    # Sterblichkeit (jährlich)
    sterblichkeit_kinder      = 0.045
    sterblichkeit_jung        = 0.010
    sterblichkeit_erwerb      = 0.018
    sterblichkeit_alt         = 0.11
    sterblichkeit_armut       = 0.3     # Zu-/Abschlag je 50 Punkte Lebensstandard

    # Tragfähigkeit und Lebensstandard
    tragfaehigkeit_stadt      = 1.75    # Faktor für Städte mit Amt (Markt, Handel, Gewerbe)
    lebensstandard_bezug      = 9       # Realeinkommen (Taler pro Kopf und Jahr) für Lebensstandard 50
    lebensstandard_anpassung  = 0.25    # Anteil der Lücke zum Ziel je Monat

    # Bildung
    bildung_stadt             = 1.25    # Faktor der Alphabetisierung in Städten
    bildung_anpassung         = 0.03    # Anteil der Lücke zum Ziel je Jahr (Generationenwechsel)

    # Wanderung
    wanderung_ziele           = 4       # nächstgelegene Orte mit Daten
    wanderung_radius_km       = 60
    wanderung_rate            = 0.3     # Anteil der Jungen je Jahr bei 100 Punkten Unterschied
    wanderung_max             = 0.12    # höchstens dieser Anteil der Jungen je Jahr
    wanderung_landreserve     = 20      # Punkte Anziehung für freies Land (Agrarberufe)
    wanderung_fremd           = 0.5     # Faktor über Landesgrenzen (Leibeigenschaft, Abzugsgeld)
    auswanderung_schwelle     = 30      # unter diesem Lebensstandard wird ausgewandert
    auswanderung_rate         = 0.05    # Anteil der Jungen je Jahr und 100 Punkte unter der Schwelle

    # Blöcke
    block_mindestgroesse      = 1       # kleinere Blöcke gehen im ähnlichsten Block auf (Personen)
    wanderung_mindestmenge    = 0.05    # kleinere Wanderungsströme entfallen (Personen)

    # ─── Wirtschaft und Staatshaushalt (seit M5) ────────────────────────────
    # Startwerte aus docs/technik/wirtschaft.md, Abschnitt 4.9 (Sicherheit: spielwert); Abstimmung
    # mit dem Balancing-Bericht, siehe data/README.md, Abschnitt "Wirtschaftswerte".

    # Märkte und Preise
    preis_min                 = 0.25    # Preis höchstens auf ein Viertel des Basispreises …
    preis_max                 = 4       # … und höchstens auf das Vierfache
    preis_anpassung           = 0.3     # Anteil der Lücke zum Zielpreis je Monat

    # Handel
    handel_nachbarn           = 6       # Nachbarmärkte je Markt …
    handel_radius_km          = 180     # … im Umkreis
    handel_rate               = 5       # Handelsmenge je Preislücke: bei 20 % Lücke die ganze mögliche Menge
    handel_fracht             = 0.12    # Frachtkosten je 100 km Landweg (Anteil am Preis)
    seefracht                 = 0.10    # Frachtkosten zum Weltmarkt (Anteil am Preis)
    bahnfracht                = 0.04    # je 100 km zwischen Märkten mit Bahnverbindung (seit M7, ein Drittel der Landfracht)
    handelsspanne             = 0.05    # Anteil der Kaufleute am Umsatz eines Marktes

    # Betriebe, Ernte, Hunger
    betrieb_anpassung         = 0.03    # Wechsel zu gewinnträchtigeren Betrieben je Monat
    betrieb_min_anteil        = 0.02    # kein erlaubter Betrieb verschwindet ganz
    ernte_schwankung_land     = 0.08    # Erntefaktor: ein Jahr für alle …
    ernte_schwankung_markt    = 0.10    # … und je Markt (Wetter, Unwetter, Schädlinge)
    sterblichkeit_hunger      = 1.5     # Zuschlag auf die Sterblichkeit, wenn Grundnahrung fehlt
    einschwingen_monate       = 60      # nur Wirtschaft vor dem Start (Preise, Betriebsanteile)

    # Staatshaushalt
    verwaltung_je_einwohner   = 0.15    # Reichstaler je Einwohner und Jahr (Ämter, Justiz, Kirche)
    sold                      = 30      # Reichstaler je Soldat und Jahr (Sold, Brot, Montur)
    reserve_jahre             = 0.5     # Rücklage in Jahresausgaben; darüber wird gebaut
    bau_anteil                = 0.05    # Anteil des Überschusses über der Rücklage, der je Monat verbaut wird
    ausbau_max                = 0.3     # Landesausbau: höchstens +30 % Tragfähigkeit …
    ausbau_halb               = 200     # … die Hälfte davon bei 200 Reichstalern je km²

    # Kredit und Staatsbankrott
    zins_basis                = 0.05    # Zins für Staaten ohne große Schulden
    zins_risiko               = 0.02    # Aufschlag je Jahreseinnahme Schulden über der ersten
    zins_max                  = 0.2
    bankrott_quote            = 4       # Bankrott bei Schulden über 4 Jahreseinnahmen
    bankrott_schnitt          = 0.5     # Schuldenschnitt
    bankrott_aufschlag        = 0.04    # Zinsaufschlag danach …
    bankrott_jahre            = 20      # … für so viele Jahre
}
