# Militär (Meilenstein M10, Schritte a1–a4 und b1; docs/technik/militaer.md, Abschnitte 3–6).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.30.
# Das Militär gilt ab 'seit' (Entscheidung 14): Vor diesem Datum (Lesezeichen 1648) gibt es keine Heere,
# und die Simulation bleibt bitgleich. Die Friedensstärke eines Staates ist wie im Haushalt 'heer'
# (Soldaten je 1.000 Einwohner) mal Bevölkerung; die Garnisonen teilen sie nach 'anteil' auf. Ein
# Staat ohne Garnison hat eine in seiner Hauptstadt.
#
# Werte: Spielwerte nach Wissensstand ohne Quellenzugang (Prüfung offen).

militaer {
    seit       = 1848.03.01   # Lesezeichen „Völkerfrühling“
    fluss_rang = 3            # Flussübergang bis Rang 3 (Rhein … Weser, Mosel … Main, Inn, Moldau; nachbarn.csv)

    # Bewegung (Schritt a2, militaer.md Abschnitt 3.4): Marschtage = Abstand ÷ marsch_km × Gelände des
    # Zielorts, ein Flussübergang kostet flussuebergang_tage mehr. Bahn: Einladen nach bahn_kapazitaet
    # Soldaten je Strecke und Tag, Fahrt bahn_km je Tag, Ausladen ausladen_tage.
    marsch_km           = 20
    flussuebergang_tage = 1
    gelaende            = { hochgebirge = 2 mittelgebirge = 1.5 wald = 1.5 bruch = 1.5 }
    bahn_km             = 300
    bahn_kapazitaet     = 20000
    ausladen_tage       = 1

    # Versorgung (Abschnitt 3.5): versorgt in eigenem oder verbündetem Gebiet, sonst höchstens
    # versorgung_tage Tagesmärsche von einem Bahnhof der eigenen Seite. Zermürbung je Tag; im Winter
    # (Dezember bis Februar) doppelt.
    versorgung_tage        = 3
    zermuerbung            = 0.0005
    zermuerbung_unversorgt = 0.005
    moral_unversorgt       = 0.02
    moral_erholung         = 0.04

    # Mobilmachung (Abschnitt 3.3): Abrüstung in demobilmachung_tage zurück in die Garnisonen.
    demobilmachung_tage = 30

    # Krieg und Schlacht (Schritt a3, Abschnitte 4.1 und 4.2). Kampfkraft = (Soldaten × Bewaffnung +
    # Geschütze × geschuetz_wert) × eingesetzter Anteil (Frontbreite ÷ Geländefaktor) × Moral; der
    # Verteidiger mal Gelände, Festung und Flussübergang des Angreifers. Verluste je Tag = verlustrate ×
    # Kampfkraft des Gegners × Zufall (0,8–1,2); Bruch unter bruch_moral oder bei Tagesverlusten über
    # bruch_verluste.
    kriegserklaerung_beziehung = -20
    frontbreite                = 50000
    gelaende_verteidigung      = 0.5
    flussverteidigung          = 1.5
    festung_verteidigung       = 0.5
    geschuetz_wert             = 50
    verlustrate                = 0.08
    moralverlust               = 5
    bruch_moral                = 0.3
    bruch_verluste             = 0.25
    moral_sieg                 = 0.3     # seit b2: so viel Moral gewinnen die Sieger einer Schlacht zurück
    gefallene                  = 0.25    # Anteil der Verluste; die übrigen sind verwundet
    verwundete_rueckkehr       = 0.5     # … davon kehren zurück nach genesung_tage
    genesung_tage              = 60
    gefangene_rueckzug         = 0.1     # Verfolgung: Anteil der Soldaten, die beim Rückzug gefangen werden
    verwuestung_verluste       = 100000  # so viele Verluste verwüsten einen Ort ganz

    # Belagerung (Abschnitt 4.3): Tage = belagerung_tage × Stufe × Besatzung ÷ (Soldaten + Geschütze ×
    # geschuetz_wert der Belagerer), mindestens belagerung_mindesttage; Besatzung = festung_besatzung × Stufe.
    belagerung_tage        = 30
    belagerung_mindesttage = 10
    festung_besatzung      = 5000

    # Kriegsziele, Kriegspunkte und Frieden (Schritt a4, Abschnitt 4.5): Kosten der Ziele in Kriegspunkten;
    # Punkte aus Besetzung (× besetzte Bevölkerung ÷ Bevölkerung des Gegners), Hauptstadt, Schlachten
    # (× Verlustbilanz ÷ Kriegsstärke, höchstens so viel) und vernichteten Heeren; Kriegsmüdigkeit aus
    # Verlusten, Besetzung und Monaten. Ohne Bewegung endet ein Krieg nach stillstand_monate.
    ziel_gebiet            = 100   # × Anteil an der Bevölkerung des Gegners
    ziel_gebiet_mindestens = 5
    ziel_annexion          = 80
    ziel_fuehrung          = 20
    ziel_zollunion         = 30
    ziel_entschaedigung    = 10    # je Monatseinnahme
    punkte_besetzung       = 60
    punkte_hauptstadt      = 20
    punkte_schlachten      = 30
    punkte_heer            = 10
    punkte_heer_anteil     = 0.1   # seit b2: ein Heer zählt ab diesem Anteil an der Kriegsstärke seiner Seite
    muedigkeit_verluste    = 100
    muedigkeit_besetzung   = 100
    muedigkeit_monat       = 2
    stillstand_monate      = 12

    # Generalstab (Abschnitt 5): führt alle Heere, bis ein Befehl 'Marsch' oder 'Generalstab' sie übernimmt.
    generalstab               = ja
    generalstab_angriff       = 1.2
    generalstab_rueckzug      = 2
    generalstab_umkreis_km    = 60
    generalstab_reichweite_km = 150
    generalstab_moral         = 0.5   # seit b2: darunter erholt sich ein Heer, statt anzugreifen oder vorzurücken

    # Führung (Schritt b1): Kampfkraft × (1 + fuehrung × (Führung − 1)) je Heer; die Heere des Aufmarschs
    # tragen Befehlshaber mit Führung 0–3, alle übrigen Führung 1 (ohne Wirkung).
    fuehrung = 0.2
}

# ── Heerwesen ──────────────────────────────────────────────────────────────
# bewaffnung: Feuerkraft der Infanterie (Vorderlader = 1); geschuetze: je 1.000 Soldaten;
# mobilmachung: Kriegsstärke ÷ Friedensstärke (Reserve, Landwehr); mobilmachung_tage: bis zur vollen Stärke.

heerwesen standard {
    bewaffnung        = 1.0
    geschuetze        = 2.5
    mobilmachung      = 2.0
    mobilmachung_tage = 35
    quelle = "Spielwert M10: Vorderlader, rund 2–3 Geschütze je 1.000 Mann, Kontingente des Bundesheers"
}

heerwesen pru_1848 {
    staat             = PRU
    seit              = 1848.03.01
    bewaffnung        = 1.2      # Zündnadelgewehr (1841) erst bei einem Teil der Infanterie
    geschuetze        = 3
    mobilmachung      = 2.5      # Reserve und Landwehr ersten Aufgebots
    mobilmachung_tage = 28
    quelle = "Spielwert M10: Dreyse-Zündnadelgewehr seit 1841, 1848 noch nicht allgemein; Landwehrordnung von 1815"
}

heerwesen aut_1848 {
    staat             = AUT
    seit              = 1848.03.01
    bewaffnung        = 1.0
    geschuetze        = 3
    mobilmachung      = 2.0
    mobilmachung_tage = 42
    quelle = "Spielwert M10: Vorderlader (Augustin-Gewehr), lange Wege der Mobilmachung im Vielvölkerstaat"
}

# ── Garnisonen 1848 ────────────────────────────────────────────────────────
# Preußen: Gardekorps und acht Armeekorps an den Sitzen der Generalkommandos.

garnison pru_garde { staat = PRU ort = berlin_coelln  anteil = 0.12 name = "Gardekorps"       seit = 1848.03.01 }
garnison pru_1     { staat = PRU ort = koenigsberg    anteil = 0.11 name = "I. Armeekorps"    seit = 1848.03.01 }
garnison pru_2     { staat = PRU ort = stettin        anteil = 0.11 name = "II. Armeekorps"   seit = 1848.03.01 }
garnison pru_3     { staat = PRU ort = frankfurt_oder anteil = 0.11 name = "III. Armeekorps"  seit = 1848.03.01 }
garnison pru_4     { staat = PRU ort = magdeburg      anteil = 0.11 name = "IV. Armeekorps"   seit = 1848.03.01 }
garnison pru_5     { staat = PRU ort = posen          anteil = 0.11 name = "V. Armeekorps"    seit = 1848.03.01 }
garnison pru_6     { staat = PRU ort = breslau        anteil = 0.11 name = "VI. Armeekorps"   seit = 1848.03.01 }
garnison pru_7     { staat = PRU ort = muenster       anteil = 0.11 name = "VII. Armeekorps"  seit = 1848.03.01 }
garnison pru_8     { staat = PRU ort = koblenz        anteil = 0.11 name = "VIII. Armeekorps" seit = 1848.03.01 }

# Österreich (nur die Länder im Kartenausschnitt): Generalkommanden.
garnison aut_wien      { staat = AUT ort = wien      anteil = 0.35 name = "Generalkommando Wien"       seit = 1848.03.01 }
garnison aut_prag      { staat = AUT ort = prag      anteil = 0.25 name = "Generalkommando Prag"       seit = 1848.03.01 }
garnison aut_olmuetz   { staat = AUT ort = olmuetz   anteil = 0.15 name = "Generalkommando Mähren"     seit = 1848.03.01 }
garnison aut_graz      { staat = AUT ort = graz      anteil = 0.10 name = "Generalkommando Graz"       seit = 1848.03.01 }
garnison aut_laibach   { staat = AUT ort = laibach   anteil = 0.08 name = "Garnison Laibach"           seit = 1848.03.01 }
garnison aut_innsbruck { staat = AUT ort = innsbruck anteil = 0.07 name = "Generalkommando Innsbruck"  seit = 1848.03.01 }

# Bayern: zwei Armeekorps und Nürnberg.
garnison bav_1         { staat = BAV ort = muenchen  anteil = 0.50 name = "I. Armeekorps"  seit = 1848.03.01 }
garnison bav_2         { staat = BAV ort = wuerzburg anteil = 0.30 name = "II. Armeekorps" seit = 1848.03.01 }
garnison bav_nuernberg { staat = BAV ort = nuernberg anteil = 0.20 name = "Garnison Nürnberg" seit = 1848.03.01 }

# ── Festungen 1848 (Schritt a3, Abschnitt 4.3) ─────────────────────────────
# Stufe 1–3 als Spielwert nach Wissensstand ohne Quellenzugang (ungeprüft): Bundesfestungen, preußische,
# österreichische und bayerische Landesfestungen, Rendsburg. Ulm und Rastatt waren 1848 im Bau (seit
# 1842). Die Festungen in Frankreich (Metz, Straßburg, Bitsch) folgen mit Frankreich (Schritt b1).

festung mainz       { ort = mainz               stufe = 3 name = "Bundesfestung Mainz" }
festung luxemburg   { ort = luxemburg           stufe = 3 name = "Bundesfestung Luxemburg" bis = 1867.09.09 }   # geschleift nach dem Londoner Vertrag
festung landau      { ort = landau_in_der_pfalz stufe = 2 name = "Bundesfestung Landau" }
festung ulm         { ort = ulm                 stufe = 2 name = "Bundesfestung Ulm" }
festung rastatt     { ort = rastatt             stufe = 2 name = "Bundesfestung Rastatt" }

festung koblenz     { ort = koblenz     stufe = 3 name = "Festung Koblenz und Ehrenbreitstein" }
festung koeln       { ort = koeln       stufe = 3 }
festung magdeburg   { ort = magdeburg   stufe = 3 }
festung posen       { ort = posen       stufe = 3 }
festung danzig      { ort = danzig      stufe = 3 }
festung koenigsberg { ort = koenigsberg stufe = 2 }
festung stettin     { ort = stettin     stufe = 2 }
festung kuestrin    { ort = kuestrin    stufe = 2 }
festung glogau      { ort = glogau      stufe = 2 }
festung neisse      { ort = neisse      stufe = 2 }
festung glatz       { ort = glatz       stufe = 2 }
festung thorn       { ort = thorn       stufe = 2 }
festung graudenz    { ort = graudenz    stufe = 2 }
festung wesel       { ort = wesel       stufe = 2 }
festung minden      { ort = minden      stufe = 2 }
festung saarlouis   { ort = saarlouis   stufe = 2 }
festung torgau      { ort = torgau      stufe = 2 }
festung wittenberg  { ort = wittenberg  stufe = 1 }
festung erfurt      { ort = erfurt      stufe = 1 }
festung juelich     { ort = juelich     stufe = 1 }
festung pillau      { ort = pillau      stufe = 1 }
festung kolberg     { ort = kolberg     stufe = 1 }
festung swinemuende { ort = swinemuende stufe = 1 }

festung olmuetz      { ort = olmuetz      stufe = 3 }
festung koeniggraetz { ort = koeniggraetz stufe = 2 }
festung josefstadt   { ort = jaromer      stufe = 2 name = "Festung Josefstadt" }

festung ingolstadt  { ort = ingolstadt  stufe = 3 }
festung germersheim { ort = germersheim stufe = 2 }
festung wuerzburg   { ort = wuerzburg   stufe = 1 name = "Festung Marienberg" }

festung rendsburg   { ort = rendsburg   stufe = 2 }

# ── 1849–1870 (Schritt b1, militaer.md Abschnitt 6.2) ──────────────────────
# Für die Kriegslesezeichen 1864, 1866 und 1870; das Lesezeichen 1848 bleibt unberührt (alles mit
# späterem 'seit'). Heerwesen: es gilt der jüngste Eintrag bis zum Start.

heerwesen pru_1860 {
    staat             = PRU
    seit              = 1860.02.10
    bewaffnung        = 1.5      # Zündnadelgewehr allgemein, Schnellfeuer im Liegen
    geschuetze        = 3
    mobilmachung      = 2.8      # Heeresreform: drei Jahrgänge Dienst, vier Reserve, Landwehr
    mobilmachung_tage = 21       # Mobilmachungsplan mit der Bahn (1866 und 1870 rund drei Wochen)
    quelle = "Spielwert M10b: Heeresreform Roons ab 1860; Wissensstand ohne Quellenzugang"
}

heerwesen aut_1859 {
    staat             = AUT
    seit              = 1859.07.01
    bewaffnung        = 1.2      # Lorenz-Vorderlader (weittragend, langsam), Stoßtaktik
    geschuetze        = 3.5      # gezogene Vorderlader-Artillerie, 1866 der preußischen überlegen
    mobilmachung      = 2.2
    mobilmachung_tage = 42
    quelle = "Spielwert M10b: Armee nach Solferino; Wissensstand ohne Quellenzugang"
}

heerwesen den_1849 {
    staat             = DEN
    seit              = 1849.01.01
    bewaffnung        = 1.0
    geschuetze        = 3
    mobilmachung      = 2.0
    mobilmachung_tage = 30
    quelle = "Spielwert M10b: dänisches Heer 1864 mit Vorderladern; Wissensstand ohne Quellenzugang"
}

heerwesen sax_1867 {
    staat             = SAX
    seit              = 1867.01.01
    bewaffnung        = 1.5      # preußisches Muster im Norddeutschen Bund (XII. Armeekorps)
    geschuetze        = 3
    mobilmachung      = 2.6
    mobilmachung_tage = 21
    quelle = "Spielwert M10b: Militärkonvention mit Preußen 1867; Wissensstand ohne Quellenzugang"
}

heerwesen bav_1867 {
    staat             = BAV
    seit              = 1867.01.01
    bewaffnung        = 1.3      # Podewils-Hinterlader umgebaut, Werder-Gewehr ab 1869
    geschuetze        = 2.5
    mobilmachung      = 2.4
    mobilmachung_tage = 28
    quelle = "Spielwert M10b: bayerische Heeresreform nach 1866; Wissensstand ohne Quellenzugang"
}

heerwesen frk_1849 {
    staat             = FRK
    seit              = 1849.01.01
    bewaffnung        = 1.0
    geschuetze        = 2.5
    mobilmachung      = 1.6      # Berufsheer mit wenig Reserve
    mobilmachung_tage = 28
    quelle = "Spielwert M10b: französisches Heer mit langer Dienstzeit; Wissensstand ohne Quellenzugang"
}

heerwesen frk_1866 {
    staat             = FRK
    seit              = 1866.08.30
    bewaffnung        = 1.7      # Chassepot (1866), reicht weiter als das Zündnadelgewehr; Mitrailleuse
    geschuetze        = 2.5      # Vorderlader-Artillerie, der Krupp-Hinterladern unterlegen
    mobilmachung      = 1.6      # Garde mobile kaum ausgebildet, Mobilmachung 1870 ungeordnet
    mobilmachung_tage = 21
    quelle = "Spielwert M10b: Armee nach der Reform Niels (1868); Wissensstand ohne Quellenzugang"
}

# Garnisonen nach 1864/1866: die neuen preußischen Armeekorps, das sächsische XII. Korps, Frankreich.
garnison aut_holstein { staat = AUT ort = kiel      anteil = 0.02 name = "Brigade Kalik"         seit = 1865.08.14 bis = 1866.06.12 }
garnison pru_9        { staat = PRU ort = rendsburg anteil = 0.11 name = "IX. Armeekorps"        seit = 1866.09.20 }
garnison pru_10       { staat = PRU ort = hannover  anteil = 0.11 name = "X. Armeekorps"         seit = 1866.09.20 }
garnison pru_11       { staat = PRU ort = kassel    anteil = 0.11 name = "XI. Armeekorps"        seit = 1866.09.20 }
garnison sax_12       { staat = SAX ort = dresden   anteil = 1    name = "XII. Armeekorps"       seit = 1867.01.01 }
garnison frk_metz       { staat = FRK ort = metz       anteil = 0.4 name = "Garnison Metz"       seit = 1849.01.01 }
garnison frk_strassburg { staat = FRK ort = strassburg anteil = 0.3 name = "Garnison Straßburg"  seit = 1849.01.01 }
garnison frk_lille      { staat = FRK ort = lille      anteil = 0.2 name = "Garnison Lille"      seit = 1849.01.01 }
garnison frk_belfort    { staat = FRK ort = beffert    anteil = 0.1 name = "Garnison Belfort"    seit = 1849.01.01 }

# Festungen 1849–1870: Danewerk und Düppeler Schanzen (1864), Frankreich (ab 1849 in der Welt).
festung danewerk     { ort = schleswig    stufe = 1 name = "Danewerk"           seit = 1861.01.01 bis = 1864.10.30 }
festung dueppel      { ort = gravenstein  stufe = 3 name = "Düppeler Schanzen"  seit = 1861.01.01 bis = 1864.10.30 }
festung metz         { ort = metz         stufe = 3 seit = 1849.01.01 }
festung strassburg   { ort = strassburg   stufe = 3 seit = 1849.01.01 }
festung belfort      { ort = beffert      stufe = 2 name = "Festung Belfort" seit = 1849.01.01 }
festung bitsch       { ort = bitsch       stufe = 2 seit = 1849.01.01 }
festung diedenhofen  { ort = diedenhofen  stufe = 2 seit = 1849.01.01 }
festung pfalzburg    { ort = pfalzburg    stufe = 1 seit = 1849.01.01 }
festung toul         { ort = toul         stufe = 1 seit = 1849.01.01 }
festung verdun       { ort = verdun       stufe = 1 seit = 1849.01.01 }
festung sedan        { ort = sedan        stufe = 1 seit = 1849.01.01 }
festung longwy       { ort = longwy       stufe = 1 seit = 1849.01.01 }
festung montmedy     { ort = montmedy     stufe = 1 seit = 1849.01.01 }
festung schlettstadt { ort = schlettstadt stufe = 1 seit = 1849.01.01 }

# Hinterland (Entscheidung 12, Abschnitt 6.2): Land außerhalb des Kartenausschnitts. Einnahmen im
# Maßstab des Modells (rund 1 Taler je Einwohner und Jahr wie die Staaten 1848), Ersatz je Kriegsmonat.
hinterland FRK {
    bevoelkerung = 31400000   # Frankreich 1846 rund 35,4 Mio., davon 4,0 Mio. im Kartenausschnitt
    einnahmen    = 2600000
    ersatz       = 25000      # Depots, Garde mobile, nach Sedan die Heere der Republik
    orte         = { verdun sedan charleville_mezieres bar_le_duc }
    quelle       = "Spielwerte M10b nach Wissensstand ohne Quellenzugang; Kalibrierung in b2"
}

hinterland DEN {
    bevoelkerung = 1600000    # Königreich nördlich der Königsau, Seeland und Fünen (Zählung 1860)
    einnahmen    = 130000
    ersatz       = 3000
    orte         = { christiansfeld roedding }
    quelle       = "Spielwerte M10b nach Wissensstand ohne Quellenzugang; Kalibrierung in b2"
}
