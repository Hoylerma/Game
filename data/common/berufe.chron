# Berufsgruppen der Epoche 1648–1806 (Meilenstein M1, vereinfacht).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.4. Seit M5 erzeugen die Berufe in Betrieben
# (betriebe.chron); das Feld ertrag (fester Ertrag je Kopf) entfällt.
#   steuerpflichtig – Adel und Geistlichkeit sind von der Kontribution befreit
#                     (ständische Privilegien)
#   anteil_stadt    – Anteil an der Bevölkerung städtischer Orte (Stadt mit
#                     Umland, daher auch Ackerbürger und Bauern)
#   anteil_land     – Anteil an der Bevölkerung ländlicher Orte
# Die Summen der Anteile ergeben je genau 1.
#   agrar           – Ertrag hängt am Boden: Ist ein Ort übervölkert (mehr Einwohner als
#                     Tragfähigkeit), sinkt der Ertrag je Kopf (seit M4)
#   bildung         – Alphabetisierung als Grundwert 0..1 (seit M4); wird mit Konfession, Stadt
#                     und Lebensstandard verrechnet (docs/technik/bevoelkerung.md, Abschnitt 4.4)
#   in_stadt        – optional: Beruf nach dem Zuzug in eine Stadt (seit M4); ein Bauernsohn,
#                     der in die Stadt zieht, findet dort keinen Hof, sondern Arbeit als Tagelöhner
#   agrarabgabe     – optional: Anteil am Agrarertrag des Ortes (seit M5; Grundrente des Adels,
#                     Zehnt der Geistlichkeit). Ohne Angehörige im Ort bleibt er bei den Bauern.
#
# Alphabetisierung um 1650 (Größenordnung, Spielwerte): insgesamt etwa 10–20 %, in Städten
# deutlich mehr; Geistliche und Gelehrte fast vollständig, Adel und Kaufleute überwiegend,
# Handwerksmeister teilweise, Bauern und Gesinde selten.
#
# Größenordnungen (Schätzung, Spielwerte): Ein Tagelöhner verdiente um 1650
# einige Groschen am Tag (1 Reichstaler = 24 Groschen), also wenige Dutzend
# Taler im Jahr für einen ganzen Haushalt; Vollbauern, Handwerksmeister und
# Kaufleute lagen deutlich darüber. Seit M5 entstehen die Einkommen auf den Märkten
# (nach dem Einschwingen je Kopf und Jahr etwa: Landarme 4, Bauern 7,5, Handwerker 7,
# Bürger 18, Geistlichkeit 17, Adel 63 Reichstaler); Adel und Geistlichkeit leben von
# Grundrente und Zehnt (agrarabgabe).
#
# Anteile in Orten mit Stadtrecht (Stadt mit ihrem Amt, also mit Dörfern): seit M5
# Bürger 8 %, Handwerker 16 %, Bauern 30 %, Landarme 44 % (bis M4 15/30/20/33 %, für
# einen Markt zu städtisch; docs/technik/wirtschaft.md, Abschnitt 4.9).

beruf adel {
    name            = "Adel"
    schicht         = oben
    steuerpflichtig = nein
    anteil_stadt    = 0.005
    anteil_land     = 0.010
    agrar           = nein
    bildung         = 0.8
    agrarabgabe     = 0.08    # Grundrente: Abgaben und Dienste der Bauern (Spielwert)
}

beruf geistlichkeit {
    name            = "Geistlichkeit"
    schicht         = mittel
    steuerpflichtig = nein
    anteil_stadt    = 0.015
    anteil_land     = 0.010
    agrar           = nein
    bildung         = 0.95
    agrarabgabe     = 0.05    # Zehnt und Pfarrland (Spielwert)
}

beruf buerger {
    name            = "Bürger"
    schicht         = mittel
    steuerpflichtig = ja
    anteil_stadt    = 0.080
    anteil_land     = 0.010
    agrar           = nein
    bildung         = 0.6
}

beruf handwerker {
    name            = "Handwerker"
    schicht         = mittel
    steuerpflichtig = ja
    anteil_stadt    = 0.160
    anteil_land     = 0.060
    agrar           = nein
    bildung         = 0.3
}

beruf bauern {
    name            = "Bauern"
    schicht         = unten
    steuerpflichtig = ja
    anteil_stadt    = 0.300
    anteil_land     = 0.520
    agrar           = ja
    bildung         = 0.1
    in_stadt        = landarme
}

beruf landarme {
    name            = "Landarme"
    schicht         = unten
    steuerpflichtig = ja
    anteil_stadt    = 0.440
    anteil_land     = 0.390
    agrar           = ja
    bildung         = 0.05
    selbststaendig  = 0.6   # Wahlrecht 1848 (seit M8): Gesinde und Tagelöhner galten vielerorts nicht als selbstständig
}

# ─── Frühe Industrie (seit M7) ──────────────────────────────────────────────
# Erst ab 1800 (seit, chronik-skript.md Abschnitt 3.18); die Anteile kommen aus den Landarmen
# (anteil_aus), so bleibt die Summe 1 und das Szenario 1648 unverändert.

beruf fabrikarbeiter {
    name            = "Fabrikarbeiter"   # Fabrik-, Hütten- und Bergarbeiter
    schicht         = unten
    steuerpflichtig = ja
    anteil_stadt    = 0.060
    anteil_land     = 0.015
    agrar           = nein
    bildung         = 0.15
    seit            = 1800.01.01
    anteil_aus      = landarme
    selbststaendig  = 0.7   # Wahlrecht 1848 (seit M8): Fabrikarbeiter im Kost- und Logis-Verhältnis zum Teil ausgeschlossen
}
