    gewicht = 2
    schlagzeile = "Thronwechsel in {staat}"
    schlagzeile = "Ein neuer König für {staat}"
    unterzeile  = "{person} besteigt den Thron"
    text        = "Mit {person} beginnt in {staat} eine neue Regierung. Das Land wartet auf das erste Wort des neuen Herrschers."
}

anlass thron_kaiser {
    muster  = "{staat}: {person} wird Kaiser*"
    gewicht = 2
