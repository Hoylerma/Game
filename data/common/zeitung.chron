    gewicht = 2
    schlagzeile = "Neuer Großherzog in {staat}"
    unterzeile  = "{person} tritt die Regierung an"
    text        = "In {staat} beginnt mit {person} eine neue Regierung."
}

anlass thron_herzog {
    muster  = "{staat}: {person} wird Herzog*"
    gewicht = 2
    schlagzeile = "Neuer Herzog in {staat}"
    unterzeile  = "{person} tritt die Regierung an"
    text        = "In {staat} beginnt mit {person} eine neue Regierung."
}

anlass ministerium {
    muster  = "{staat}: {person} wird {amt}"
    gewicht = 1
    schlagzeile = "{staat}: {person} wird {amt}"
    unterzeile  = "Personalien aus der Regierung"
    text        = "Die Ernennung von {person} wird in {staat} aufmerksam aufgenommen."
}

anlass zollverein {
    muster  = "{staat} tritt zum {termin} dem {zollunion} bei."
    gewicht = 1
    schlagzeile = "{staat} kommt zum {zollunion}"
    unterzeile  = "Der Beitritt gilt ab dem {termin}"
    text        = "Die Zollschranken fallen. Kaufleute und Fabrikanten erwarten bessere Geschäfte."
}

# ── Wendepunkte und übrige Ereignisse ──────────────────────────────────────

anlass kaiserproklamation {
    muster   = "{staat}: {titel} – {wahl}"
    ereignis = kaiserproklamation
    gewicht  = 3
    schlagzeile = "Das Deutsche Reich ist ausgerufen"
    unterzeile  = "{wahl}"
    text        = "Der König von Preußen ist Deutscher Kaiser. Was Generationen erhofft und gefürchtet haben, ist geschehen – nicht in der Paulskirche, sondern im Rat der Fürsten."
    demokratisch {
        text = "Ein Reich ist ausgerufen, ein Kaiser gekürt – das Volk sah zu. Die Einheit ist da; die Freiheit muss sie sich erst noch erstreiten."
    }
}

anlass kaiserdeputation {
    muster   = "{staat}: {titel} – {wahl}"
    ereignis = pru.kaiserdeputation
    gewicht  = 3
    schlagzeile = "Die Antwort des Königs"
    schlagzeile = "Krone der Nation – angenommen oder verworfen?"
    unterzeile  = "{wahl}"
    text        = "Die Abordnung der Nationalversammlung hat ihre Antwort erhalten. Von ihr hängt ab, ob die Reichsverfassung lebt."
}

anlass wendepunkt_staat {
    muster     = "{staat}: {titel} – {wahl}"
    wendepunkt = ja
    gewicht    = 2
    schlagzeile = "{titel}"
    unterzeile  = "{staat}: {wahl}"
    text        = "Aus {staat} kommt eine Nachricht, die das ganze Land bewegen wird. Die Redaktion wird in den kommenden Ausgaben ausführlich berichten."
}

anlass wendepunkt_welt {
    muster     = "{titel} – {wahl}"
    wendepunkt = ja
    gewicht    = 3
    schlagzeile = "{titel}"
    unterzeile  = "{wahl}"
    text        = "Eine Nachricht, die ganz Deutschland bewegt. Die Redaktion wird in den kommenden Ausgaben ausführlich berichten."
}

anlass ereignis_staat {
    muster  = "{staat}: {titel} – {wahl}"
    gewicht = 1
    schlagzeile = "{titel}"
    unterzeile  = "{staat}: {wahl}"
    text        = "Aus {staat} wird gemeldet: {wahl}."
}

anlass ereignis_welt {
    muster  = "{titel} – {wahl}"
    gewicht = 1
    schlagzeile = "{titel}"
    unterzeile  = "{wahl}"
    text        = "Unser Korrespondent meldet: {wahl}."
}
