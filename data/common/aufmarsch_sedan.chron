# Aufmarsch des Lesezeichens „Sedan“ (19. Juli 1870; Meilenstein M10b, Schritt b1).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.32; militaer.md, Abschnitt 6.1. Die drei
# deutschen Armeen marschieren an Saar und Pfalz auf (die süddeutschen Kontingente in der III. Armee);
# die Rheinarmee steht in Lothringen und im Elsass, Canrobert noch bei Châlons (im Modell Verdun).
# Stärken ungeprüft, Führung Spielwert.

krieg deutsch_franzoesischer_krieg {
    name        = "Deutsch-Französischer Krieg"
    beginn      = 1870.07.19
    angreifer   = { FRK }
    verteidiger = { PRU SAX BAV WUE BAD HED MSC MST OLD BWO WEI SMG ALT SCG DES SSH SRU REA REJ WAL LIP SLI LUE BRE HAM }
    ziel        = { gebiet = by_pfalz }
    ziel_verteidiger = { gebiet = fr_elsass gebiet = fr_moselle entschaedigung = 6 }
    quelle      = "Kriegserklärung vom 19.7.1870; deutsche Ziele nach dem Frankfurter Frieden (10.5.1871): Elsass, Lothringen mit Metz, Entschädigung; französisches Ziel Spielwert (Kompensationsforderungen 1866)"
}

buendnis { staaten = { PRU BAV } quelle = "Schutz- und Trutzbündnis vom 22.8.1866" }
buendnis { staaten = { PRU WUE } quelle = "Schutz- und Trutzbündnis vom 13.8.1866" }
buendnis { staaten = { PRU BAD } quelle = "Schutz- und Trutzbündnis vom 17.8.1866" }

heer pru_erste_armee_1870 {
    staat        = PRU
    name         = "I. Armee"
    befehlshaber = "Karl Friedrich von Steinmetz"
    fuehrung     = 0.9
    ort          = saarlouis
    soldaten     = 60000
    quelle = "Stärke und Ort nach Wissensstand ohne Quellenzugang (ungeprüft), Führung Spielwert (M10b)"
}

