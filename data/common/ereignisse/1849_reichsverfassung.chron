        gewicht = 15
        wirkung { beziehung_SAX = -20 }
    }
}

ereignis pru.hilfe.baden {
    titel  = "Der Feldzug in Baden"
    text   = "Unter dem Prinzen von Preußen sammelt sich ein Heer aus Preußen und Bundestruppen gegen die badische Revolutionsarmee. Ludwik Mierosławski führt die Verteidiger."
