# Ereignisse 1849: Verfassungswerk, Kaiserkrone, Reichsverfassungskampagne (Meilenstein M11,
# docs/technik/ereignisse.md Abschnitt 6.1). Format: docs/technik/chronik-skript.md, Abschnitt 3.34. Quellen
# aus der Literatur (Kenntnis, ohne Seitenangaben), alle 'sicherheit = ungeprueft'.

ereignis aut.maerzverfassung {
    titel  = "Die oktroyierte Märzverfassung"
    text {
        "Fürst Schwarzenberg löst den Reichstag in Kremsier auf und erlässt eine Verfassung für den ganzen"
        "Kaiserstaat, Ungarn eingeschlossen. Ein unteilbares Österreich kann nicht mit seinen deutschen"
        "Ländern allein einem deutschen Reich beitreten."
    }
    datum  = 1849.03.04
    quelle = "Rumpler (1997); Siemann (1985)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    bedingung { staat = AUT  datum >= 1849.03.01  datum <= 1849.04.30 }
    wartezeit = 3
    option gesamtstaat {
        text = "Die Verfassung für den Gesamtstaat oktroyieren"
        historisch = ja
        gewicht = 85
        wirkung { verfassung = konstitutionell  welt_merke = oesterreich_gesamtstaat  zustimmung_militaer = 1  zustimmung_nationalbewegung = -2 }
    }
    option kremsier {
        text = "Den Kremsierer Entwurf mit Länderautonomie annehmen"
        gewicht = 15
        wirkung { verfassung = konstitutionell  zustimmung_adel = -2  zustimmung_bildungsbuergertum = 2 }
    }
}

ereignis nv.wahlrecht {
    titel  = "Das Wahlrecht der Reichsverfassung"
    text   = "Soll das Volkshaus nach allgemeinem und gleichem Wahlrecht gewählt werden oder nur von Steuerzahlern? Die Erbkaiserlichen brauchen die Stimmen der Linken; die Linke verlangt das allgemeine Wahlrecht als Preis."
    datum  = 1849.03.02
    quelle = "Siemann (1985); Botzenhart (1977)"
    sicherheit = ungeprueft
    art    = historisch
    wer    = welt
    bedingung { journal_revolution = verfassungswerk  datum >= 1849.02.20  datum <= 1849.04.30 }
    wartezeit = 7
    option abstimmen { text = "Die Versammlung stimmt ab" historisch = ja gewicht = 1 wirkung { abstimmung = wahlrecht_reich } }
}

ereignis nv.erbkaiser {
    titel  = "Erbkaiser oder Direktorium"
    text   = "Wer soll an der Spitze des Reiches stehen? Die Kleindeutschen wollen einen erblichen Kaiser aus dem Hause Hohenzollern, die Großdeutschen und die Linke ein Direktorium der Fürsten oder einen gewählten Präsidenten."
    datum  = 1849.03.27
    quelle = "Siemann (1985); Botzenhart (1977)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    wer    = welt
    bedingung { journal_revolution = verfassungswerk  datum >= 1849.03.20  datum <= 1849.05.31  geschehen = nv.wahlrecht }
    wartezeit = 4
    option abstimmen {
        text = "Die Versammlung stimmt über das Staatsoberhaupt und die Verfassung ab"
        historisch = ja
        gewicht = 1
        wirkung { abstimmung = erbkaiser  abstimmung = reichsverfassung }
    }
}

ereignis nv.kaiserwahl {
    titel  = "Die Kaiserwahl"
    text   = "Mit der Verfassung wählt die Versammlung den Kaiser. Einziger Kandidat ist Friedrich Wilhelm IV. von Preußen; die Linke enthält sich, die Österreicher bleiben der Wahl fern."
    datum  = 1849.03.28
    quelle = "Siemann (1985)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    wer    = welt
    bedingung { welt_merkmal = erbkaiser  welt_merkmal = reichsverfassung_beschlossen  datum <= 1849.06.30 }
    option waehlen {
        text = "Die Versammlung wählt"
        historisch = ja
        gewicht = 1
        wirkung { abstimmung = kaiserwahl  welt_merke = kaiserwahl_erfolgt }
    }
}

ereignis nv.direktorium {
    titel  = "Kein Kaiser"
    text   = "Die Versammlung hat das Erbkaisertum abgelehnt oder die Verfassung nicht beschlossen. Über ein Direktorium der Fürsten kann sie sich nicht einigen; die Regierungen warten ab."
    quelle = "Siemann (1985)"
    sicherheit = ungeprueft
    art    = dynamisch
    wer    = welt
    bedingung {
        journal_revolution = verfassungswerk
        oder { welt_merkmal = direktorium  welt_merkmal = reichsverfassung_gescheitert }
        datum <= 1849.06.30
    }
    option warten { text = "Die Verfassung bleibt ohne Oberhaupt" gewicht = 1 wirkung { welt_merke = kein_kaiser  welt_merke = kaiserwahl_erfolgt } }
}

ereignis pru.kaiserdeputation {
    titel  = "Die Kaiserdeputation"
    text {
        "Zweiunddreißig Abgeordnete unter Eduard Simson tragen Friedrich Wilhelm IV. im Berliner Schloss die"
        "Kaiserkrone an. Der König verachtet eine Krone aus der Hand eines Parlaments; seine Minister fürchten"
        "Österreich und Russland. Die Nation wartet auf seine Antwort."
    }
    datum  = 1849.04.03
    quelle = "Siemann (1985); Clark (2007)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    bedingung { staat = PRU  welt_merkmal = kaiser_gewaehlt  datum <= 1849.06.30 }
    wartezeit = 5
    option annehmen {
        text = "Die Krone annehmen und die Reichsverfassung anerkennen"
        gewicht = 20
        ki { expansion = 0.5  legitimitaet = -0.5 }
        gewicht_wenn { zustimmung_nationalbewegung >= 5  plus = 10 }
        gewicht_wenn { unruhe >= 60  plus = 10 }
        wirkung {
            welt_merke = krone_angenommen
            merke = reichsverfassung
            zustimmung_nationalbewegung = 4
            zustimmung_bildungsbuergertum = 3
            zustimmung_adel = -3
            zustimmung_militaer = -2
            beziehung_AUT = -40
            chronik = "Preußen: In dieser Geschichte nimmt Friedrich Wilhelm IV. die Kaiserkrone der Paulskirche an."
        }
    }
    option ablehnen {
        text = "Die Krone ablehnen: ohne die Zustimmung der Fürsten keine Antwort"
        historisch = ja
        gewicht = 50
        ki { legitimitaet = 0.5 }
        wirkung { welt_merke = krone_abgelehnt  zustimmung_nationalbewegung = -4  zustimmung_bildungsbuergertum = -2  zustimmung_adel = 2  unruhe = 10 }
    }
    option bedingungen {
        text = "Eine Union mit den Fürsten anbieten, aber nicht aus der Hand des Parlaments"
        gewicht = 30
        ki { reform = 0.5 }
        wirkung { welt_merke = krone_abgelehnt  welt_merke = unionsplan  zustimmung_nationalbewegung = -2  unruhe = 5 }
    }
}

ereignis aut.reichsverfassung {
    titel  = "Österreich und das Reich"
    text   = "Mit der Krone für Preußen und dem großdeutschen Grundsatz der Paragraphen 2 und 3 steht Österreich vor der Wahl: seine deutschen Länder ins Reich führen oder den Gesamtstaat zusammenhalten."
    quelle = "Wollstein (1977)"
    sicherheit = ungeprueft
    art    = dynamisch
    bedingung { staat = AUT  welt_merkmal = krone_angenommen  welt_merkmal = grossdeutsch  datum <= 1849.12.31 }
    wartezeit = 10
    option beitreten {
        text = "Die deutschen Länder treten dem Reich bei"
        gewicht = 10
        gewicht_wenn { welt_merkmal = oesterreich_gesamtstaat  plus = -10 }
        wirkung { merke = reichsverfassung  zustimmung_militaer = -3  zustimmung_adel = -3  zustimmung_nationalbewegung = 4 }
    }
    option gesamtstaat {
        text = "Den Gesamtstaat zusammenhalten und das Reich nicht anerkennen"
        historisch = ja
        gewicht = 90
        wirkung { zustimmung_nationalbewegung = -2  beziehung_PRU = -20 }
    }
}

ereignis reichsverfassung.anerkennung {
    titel  = "Die Anerkennung der Reichsverfassung"
    text {
        "Die Reichsverfassung liegt vor, die Regierungen sollen sie anerkennen. Volksversammlungen und"
        "Märzvereine drängen; die Höfe der Königreiche zögern. Achtundzwanzig Regierungen erklären im April"
        "ihre Zustimmung."
    }
    datum  = 1849.04.14
    quelle = "Siemann (1985); Huber Bd. 2 (1960)"
    sicherheit = ungeprueft
    art    = historisch
    bedingung {
        bund = ja
        nicht { staat_in = { AUT PRU DEN NED LIE } }
        welt_merkmal = reichsverfassung_beschlossen
        oder { journal_revolution = kaiserkrone  journal_revolution = kampagne }
        datum <= 1849.07.31
    }
    wartezeit = 12
    option anerkennen {
        text = "Die Reichsverfassung anerkennen"
        historisch = ja
        gewicht = 70
        ki { reform = 0.5 }
        gewicht_wenn { staat_in = { BAV SAX HAN }  plus = -60 }
        gewicht_wenn { welt_merkmal = krone_angenommen  plus = 30 }
        gewicht_wenn { unruhe >= 60  plus = 20 }
        wirkung { merke = reichsverfassung  zustimmung_nationalbewegung = 2  zustimmung_adel = -1  unruhe = -10 }
    }
    option ablehnen {
        text = "Die Anerkennung verweigern"
        gewicht = 30
        ki { legitimitaet = 0.5 }
        wirkung { zustimmung_nationalbewegung = -3  zustimmung_bildungsbuergertum = -2  unruhe = 15 }
    }
}

ereignis sax.maiaufstand {
    titel  = "Der Dresdner Maiaufstand"
    text {
        "König Friedrich August II. hat die Reichsverfassung abgelehnt und die Kammern aufgelöst. In Dresden"
        "errichten Bürger, Turner und Arbeiter Barrikaden; Richard Wagner und Gottfried Semper sind unter"
        "ihnen, Bakunin berät die provisorische Regierung. Der König flieht auf die Festung Königstein."
    }
    datum  = 1849.05.03
    quelle = "Siemann (1985); Weber, Revolution in Sachsen 1848/49 (1970)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    bedingung { staat = SAX  journal_revolution = kampagne  nicht { merkmal = reichsverfassung }  datum <= 1849.07.31 }
    wartezeit = 5
    option preussen {
        text = "Preußische Truppen zu Hilfe rufen"
        historisch = ja
        gewicht = 70
        ki { legitimitaet = 0.5  reform = -0.5 }
        wirkung { unruhe = 30  aufstand = barrikaden  merke = aufstand_1849  zustimmung_bildungsbuergertum = -2 }
    }
    option nachgeben {
        text = "Die Reichsverfassung doch anerkennen"
        gewicht = 30
        ki { reform = 0.5 }
        wirkung { merke = reichsverfassung  zustimmung_adel = -2  zustimmung_militaer = -2  unruhe = -20 }
    }
}

ereignis bav.pfalz {
    titel  = "Der Pfälzer Aufstand"
    text   = "In der bayerischen Pfalz, links des Rheins, beschließt ein Landesverteidigungsausschuss, die Reichsverfassung gegen die Münchner Regierung durchzusetzen. Viele Soldaten laufen über."
    datum  = 1849.05.02
    quelle = "Siemann (1985)"
    sicherheit = ungeprueft
    art    = historisch
    bedingung { staat = BAV  journal_revolution = kampagne  nicht { merkmal = reichsverfassung }  datum <= 1849.07.31 }
    wartezeit = 7
    option erhebung {
        text = "Die Pfalz sagt sich von München los"
        historisch = ja
        gewicht = 70
        wirkung { unruhe = 25  aufstand = agrarunruhen  merke = aufstand_1849 }
    }
    option nachgeben {
        text = "München erkennt die Reichsverfassung an"
        gewicht = 30
        wirkung { merke = reichsverfassung  zustimmung_katholische_kirche = -2  zustimmung_adel = -2  unruhe = -15 }
    }
}

ereignis bad.revolution {
    titel  = "Die Badische Revolution"
    text {
        "In Rastatt meutert die Garnison, in Offenburg tagt eine Landesversammlung der Volksvereine."
        "Großherzog Leopold flieht aus Karlsruhe; Lorenz Brentano bildet eine Regierung, die die"
        "Reichsverfassung verteidigen will. Die badische Armee steht auf der Seite der Revolution."
    }
    datum  = 1849.05.13
    quelle = "Siemann (1985); Mommsen (1998)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    bedingung { staat = BAD  journal_revolution = kampagne  datum <= 1849.07.31 }
    wartezeit = 7
    option meuterei {
        text = "Die Armee läuft über, der Großherzog flieht"
        historisch = ja
        gewicht = 65
        wirkung {
            unruhe = 40
            aufstand = erhebung
            merke = aufstand_1849
            zustimmung_militaer = -5
            befristet { tage = 75 text = "Meuterei der badischen Armee" moral = -0.5 }
        }
    }
    option halten {
        text = "Die Garnisonen halten aus"
        gewicht = 35
        wirkung { unruhe = 15  zustimmung_militaer = 1 }
    }
}

ereignis pru.elberfeld {
    titel  = "Elberfeld und Iserlohn"
    text   = "Im Bergischen Land und in der Grafschaft Mark verweigern Landwehrmänner den Dienst gegen die Reichsverfassung. In Elberfeld und Iserlohn entstehen Barrikaden; Friedrich Engels kommt aus Köln."
    datum  = 1849.05.09
    quelle = "Siemann (1985)"
    sicherheit = ungeprueft
    art    = historisch
    bedingung { staat = PRU  journal_revolution = kampagne  nicht { merkmal = reichsverfassung }  datum <= 1849.07.31 }
    wartezeit = 7
