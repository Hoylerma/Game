ereignis reaktion.niederwerfung {
    titel  = "Das Ende der Revolutionsregierung"
    text {
        "Fremde Truppen rücken gegen die Revolutionsregierung vor. Ihre Armee aus Bürgerwehren, Meuterern und"
        "Freischärlern zieht sich in die Festungen zurück; die Führer bereiten die Flucht in die Schweiz vor."
    }
    datum  = 1849.07.23
    quelle = "Siemann (1985); Mommsen (1998)"
    sicherheit = ungeprueft
    art    = historisch
    bedingung {
        merkmal = revolutionsregierung
        nicht { welt_merkmal = republik }
        datum >= 1849.06.01
        datum <= 1851.12.31
    }
    wartezeit = 30
    option fallen {
        text = "Die letzte Festung kapituliert"
        historisch = ja
        gewicht = 85
        wirkung {
            vergiss = revolutionsregierung
            unruhe = -20
            auswanderung = 0.01
            befristet { tage = 180 text = "Kriegsrecht nach der Revolution" unruhe = -2 steuerertrag = -0.1 }
            folge { ereignis = reaktion.standgerichte  tage = 14 }
        }
    }
    option verhandeln {
        text = "Mit den Fürsten über eine Amnestie verhandeln"
        gewicht = 15
        wirkung { vergiss = revolutionsregierung  merke = reichsverfassung  unruhe = -10  zustimmung_militaer = -2 }
    }
}

