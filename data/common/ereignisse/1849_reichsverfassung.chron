        historisch = ja
        gewicht = 75
        wirkung {
            zustimmung_militaer = 1
            unruhe = 10
            verwuestung { ort = iserlohn wert = 0.05 }
            merke = aufstand_1849
            chronik = "Preußen: Truppen schlagen die Aufstände in Elberfeld und Iserlohn nieder; es gibt Tote unter den Aufständischen und den Soldaten."
        }
    }
