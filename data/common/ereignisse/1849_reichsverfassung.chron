}

ereignis reich.mitglied {
    titel  = "Die Reichsverfassung tritt in Kraft"
    text   = "Mit dem Reich gelten die Grundrechte und die Reichsverfassung auch hier: Pressefreiheit, Vereinsrecht, Ende der Standesvorrechte, eine konstitutionelle Regierung."
    quelle = "Kühne (1985)"
    sicherheit = ungeprueft
    art    = dynamisch
    nur_folge = ja
    bedingung { merkmal = reichsverfassung }
    option a {
        text = "Die Verfassung wird eingeführt"
        gewicht = 1
        wirkung {
            verfassung = konstitutionell
            gesetz_presse = pressefreiheit
            gesetz_vereine = vereinsfreiheit
            zustimmung_nationalbewegung = 3
            zustimmung_adel = -2
            unruhe = -15
        }
    }
}
