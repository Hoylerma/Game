}

ereignis aut.sieg {
    titel  = "Österreich behauptet den Bund"
    text   = "Preußen muss um Frieden bitten. Österreich führt den Bund weiter, nun mit einem Direktorium und einer Versammlung von Delegierten der Landtage; in Berlin wankt die Regierung, die den Krieg begonnen hat."
    quelle = "Kontrafaktisch nach den Reformplänen von 1863 (Huber Bd. 3, 1963)"
