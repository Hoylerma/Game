    }
}

ereignis eisenacher.partei {
    titel  = "Die Sozialdemokratische Arbeiterpartei"
    text   = "In Eisenach gründen August Bebel und Wilhelm Liebknecht die Sozialdemokratische Arbeiterpartei. Sie ist großdeutsch, gegen Preußen und für die Internationale; mit den Lassalleanern streitet sie um die Arbeiter."
