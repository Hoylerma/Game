# Ereignisse 1863–1871: Fürstentag, Deutsch-Dänischer Krieg, Deutscher Krieg, Norddeutscher Bund und
# Reichsgründung (Meilenstein M11, docs/technik/ereignisse.md Abschnitt 6.2). Format:
# docs/technik/chronik-skript.md, Abschnitt 3.34. Texte paraphrasiert, Quellen aus der Literatur
# (Kenntnis, ohne Seitenangaben), alle 'sicherheit = ungeprueft'; Gewichte und Wirkungen sind Spielwerte.
#
# In einer Partie ab 1848 geben diese Ereignisse den Kriegen von 1864 und 1866 ihre Anlässe; die
# Kriegserklärungen liegen vor den Lesezeichen „Düppel“ (1.2.1864) und „Königgrätz“ (16.6.1866), die
# im Krieg beginnen. Die Kriege haben Kriegsziele (krieg { … }, seit b3): 1864 die drei Herzogtümer, 1866
# die Führung im Bund (der Verlierer verlässt den Bund). Den Ausgang lesen die Friedensereignisse mit
# krieg_gewonnen (seit b3).
# Frankreich hat in einer Partie ab 1848 keine Orte (militaer.md 6.1): Die Emser Depesche führt dann zu
# keinem Krieg, die Novemberverträge folgen dem Merkmal der nationalen Krise.

ereignis pru.alvensleben {
    titel  = "Die Alvensleben-Konvention"
    text   = "Im russischen Teil Polens erhebt sich der Januaraufstand. General Alvensleben vereinbart in Sankt Petersburg, dass preußische und russische Truppen Aufständische über die Grenze verfolgen dürfen. Die Westmächte protestieren, die Liberalen im Abgeordnetenhaus auch."
    datum  = 1863.02.08
    quelle = "Clark (2007); Pflanze Bd. 1 (1990)"
    sicherheit = ungeprueft
    art    = historisch
    bedingung { staat = PRU  datum >= 1863.02.01  datum <= 1863.06.30 }
    wartezeit = 10
    option konvention {
        text = "Die Konvention mit Russland schließen"
        historisch = ja
        gewicht = 60
        gewicht_wenn { merkmal = bismarck  plus = 20 }
        wirkung { merke = russlandfreundschaft  zustimmung_bildungsbuergertum = -2  zustimmung_militaer = 1 }
    }
    option neutral {
        text = "Die Grenze sperren und sich heraushalten"
        gewicht = 40
        wirkung { zustimmung_bildungsbuergertum = 1 }
    }
}

ereignis adav {
    titel  = "Der Allgemeine Deutsche Arbeiterverein"
    text   = "In Leipzig gründet Ferdinand Lassalle den Allgemeinen Deutschen Arbeiterverein. Er fordert das allgemeine, gleiche und direkte Wahlrecht und Produktivgenossenschaften mit Staatshilfe; von den Liberalen trennt er die Arbeiterbewegung."
    datum  = 1863.05.23
    quelle = "Welskopp, Das Banner der Brüderlichkeit (2000); Nipperdey (1983)"
    sicherheit = ungeprueft
    art    = historisch
    wer    = welt
    bedingung { datum >= 1863.04.01  datum <= 1863.12.31 }
    wartezeit = 30
    option gruenden {
        text = "Der Arbeiterverein wird gegründet"
        historisch = ja
        gewicht = 1
        wirkung { welt_merke = adav }
    }
}

ereignis frankfurter.fuerstentag {
    titel  = "Der Frankfurter Fürstentag"
    text {
        "Kaiser Franz Joseph lädt die deutschen Fürsten nach Frankfurt, um den Bund unter österreichischer"
        "Führung zu reformieren: ein Direktorium, eine Versammlung von Delegierten der Landtage, ein"
        "Fürstenrat. König Wilhelm möchte kommen, Bismarck droht mit dem Rücktritt."
    }
    datum  = 1863.08.16
    quelle = "Huber Bd. 3 (1963); Pflanze Bd. 1 (1990)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    wer    = welt
    bedingung { datum >= 1863.07.15  datum <= 1863.10.31  bundesversammlung = tagt  nicht { welt_merkmal = kleindeutsches_reich }  nicht { welt_merkmal = grossdeutsches_reich } }
    wartezeit = 14
    option fernbleiben {
        text = "Preußen bleibt fern, die Reform scheitert"
        historisch = ja
        gewicht = 65
        gewicht_wenn { staat PRU { merkmal = bismarck }  plus = 15 }
        wirkung { welt_merke = fuerstentag_gescheitert  staat AUT { beziehung_PRU = -15 } }
    }
    option reform {
        text = "König Wilhelm reist nach Frankfurt, der Bund erhält ein Direktorium"
        gewicht = 35
        wirkung {
            welt_merke = bundesreform_1863
            staat AUT { beziehung_PRU = 15 }
            staat PRU { zustimmung_militaer = -2  zustimmung_nationalbewegung = -1 }
            chronik = "In dieser Geschichte nimmt Preußen am Fürstentag teil; der Bund erhält ein Direktorium unter Österreich."
        }
    }
}

ereignis den.novemberverfassung {
    titel  = "Die dänische Novemberverfassung"
    text {
        "Der dänische Reichsrat beschließt eine gemeinsame Verfassung für Dänemark und Schleswig; König"
        "Christian IX. unterschreibt sie zwei Tage nach seiner Thronbesteigung. Für den Bund ist das ein"
        "Bruch des Londoner Protokolls. Die Öffentlichkeit verlangt den Krieg für Schleswig-Holstein,"
        "Preußen und Österreich wollen ihn ohne die Mittelstaaten führen."
    }
    datum  = 1863.11.18
    quelle = "Nipperdey (1983); Buk-Swienty, Schlachtbank Düppel (2011)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    wer    = welt
    bedingung {
        datum >= 1863.11.01
        datum <= 1864.01.31
        staat DEN { im_krieg = nein }
        staat PRU { im_krieg = nein }
    }
    wartezeit = 30
    option krieg {
        text = "Preußen und Österreich rücken über die Eider"
        historisch = ja
        gewicht = 80
        gewicht_wenn { staat PRU { merkmal = bismarck }  plus = 15 }
        wirkung {
            welt_merke = deutsch_daenischer_krieg
            staat PRU {
                krieg { gegner = DEN  gebiet = dk_schleswig  gebiet = dk_holstein  gebiet = dk_lauenburg }
                zustimmung_nationalbewegung = 2
            }
        }
    }
    option bundesexekution {
        text = "Nur die Bundesexekution in Holstein; Dänemark nimmt die Verfassung zurück"
        gewicht = 20
        wirkung { welt_merke = novemberverfassung_zurueck  staat DEN { beziehung_PRU = -20 } }
    }
}

ereignis wiener.frieden {
    titel  = "Der Frieden von Wien"
    text   = "Dänemark tritt Schleswig, Holstein und Lauenburg an Preußen und Österreich ab. Die Herzogtümer sind befreit, aber nicht an den Herzog von Augustenburg gefallen, den die Nationalbewegung wollte; die Sieger müssen sich nun einigen, was mit ihnen geschieht."
    datum  = 1864.10.30
    quelle = "Nipperdey (1983); Clark (2007)"
    sicherheit = ungeprueft
    art    = historisch
    wer    = welt
