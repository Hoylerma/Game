        gewicht = 25
        wirkung { zustimmung_bildungsbuergertum = -3  zustimmung_militaer = 1  unruhe = 5 }
    }
}

ereignis luxemburg.krise {
    titel  = "Die Luxemburgkrise"
    text   = "Napoleon III. will Luxemburg vom König der Niederlande kaufen, als Ausgleich für den preußischen Machtzuwachs. In Deutschland ist die Empörung groß, in der Festung Luxemburg liegt noch eine preußische Besatzung. Eine Konferenz in London soll den Krieg verhindern."
    datum  = 1867.04.01
    quelle = "Nipperdey, Deutsche Geschichte 1866–1918 Bd. 2 (1992); Pflanze Bd. 1 (1990)"
    sicherheit = ungeprueft
