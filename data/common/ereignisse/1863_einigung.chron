ereignis pru.bundesreformantrag {
    titel  = "Der preußische Bundesreformantrag"
    text {
        "Preußen beantragt im Bundestag ein deutsches Parlament aus allgemeinen, direkten Wahlen. Der"
        "Antrag des konservativen Ministerpräsidenten überrascht die Liberalen und erschreckt die Fürsten;"
        "zugleich hat Berlin ein Bündnis mit Italien geschlossen, das nur drei Monate gilt."
    }
    datum  = 1866.04.09
    quelle = "Huber Bd. 3 (1963); Clark (2007)"
    sicherheit = ungeprueft
