        }
    }
}

ereignis pru.indemnitaet {
    titel  = "Die Indemnitätsvorlage"
    text {
        "Nach dem Sieg bittet die Regierung das Abgeordnetenhaus, die Ausgaben der Konfliktjahre"
        "nachträglich zu billigen. Die Liberalen spalten sich: Die einen sehen ihr Ziel, die Einheit, in"
        "Reichweite und stimmen zu, die anderen wollen das Budgetrecht nicht preisgeben."
    }
    datum  = 1866.09.03
    quelle = "Winkler, Preußischer Liberalismus und deutscher Nationalstaat (1964); Clark (2007)"
    sicherheit = ungeprueft
