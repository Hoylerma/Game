ereignis pru.emser_depesche {
    titel  = "Die Emser Depesche"
    text {
        "Der französische Botschafter hat König Wilhelm in Bad Ems verlangt, auf alle Zeit auf die spanische"
        "Thronkandidatur eines Hohenzollern zu verzichten. Der König lehnt höflich ab und telegraphiert nach"
        "Berlin. Bismarck kann die Depesche so veröffentlichen, wie sie ist, oder sie so kürzen, dass sie in"
        "Paris wie eine Ohrfeige wirkt."
    }
    datum  = 1870.07.13
    quelle = "Pflanze Bd. 1 (1990); Wawro, The Franco-Prussian War (2003)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    bedingung { staat = PRU  welt_merkmal = norddeutscher_bund  im_krieg = nein  datum >= 1870.07.01  datum <= 1870.07.18 }
    wartezeit = 3
    option zugespitzt {
        text = "Die gekürzte Fassung veröffentlichen"
        historisch = ja
        gewicht = 65
        gewicht_wenn { merkmal = bismarck  plus = 20 }
        wirkung { welt_merke = nationalkrieg  zustimmung_nationalbewegung = 3  staat FRK { krieg = PRU } }
    }
    option unveraendert {
        text = "Die Depesche unverändert veröffentlichen"
        gewicht = 20
        wirkung { welt_merke = emser_depesche_unveraendert  beziehung_FRK = 10 }
    }
    option zurueckhalten {
        text = "Die Depesche zurückhalten und die Krise auslaufen lassen"
        gewicht = 15
        wirkung { zustimmung_nationalbewegung = -2  zustimmung_militaer = -1 }
    }
}

ereignis novembervertraege {
    titel  = "Die Novemberverträge"
    text {
        "In Versailles verhandeln die süddeutschen Staaten über den Eintritt in einen Deutschen Bund, den"
        "der Norddeutsche Bund erweitern soll. Baden und Hessen drängen, Bayern und Württemberg verlangen"
        "Reservatrechte: eigene Post, eigene Eisenbahnen, im Frieden ein eigenes Heer."
