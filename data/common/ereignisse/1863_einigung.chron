        text = "Die Herzogtümer kommen unter preußisch-österreichische Verwaltung"
        historisch = ja
        gewicht = 1
        wirkung { welt_merke = wiener_frieden  staat PRU { zustimmung_nationalbewegung = 2  zustimmung_militaer = 2 } }
    }
}

