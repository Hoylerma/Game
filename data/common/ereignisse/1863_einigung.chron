    wendepunkt = ja
    bedingung { staat = PRU  oder { welt_merkmal = gastein  merkmal = bismarck }  datum >= 1866.03.01  datum <= 1866.05.31  bundesversammlung = tagt  nicht { welt_merkmal = kleindeutsches_reich }  nicht { welt_merkmal = grossdeutsches_reich } }
    wartezeit = 14
    option beantragen {
        text = "Den Antrag stellen und mit Italien abschließen"
        historisch = ja
        gewicht = 70
        gewicht_wenn { merkmal = bismarck  plus = 20 }
        wirkung { welt_merke = preussischer_reformantrag  antrag { art = reform }  zustimmung_nationalbewegung = 2  zustimmung_adel = -1 }
    }
    option verstaendigung {
        text = "Mit Österreich über eine gemeinsame Führung des Bundes verhandeln"
        gewicht = 20
        wirkung { welt_merke = dualismus  beziehung_AUT = 20  zustimmung_militaer = -1 }
    }
}

ereignis bund.mobilmachung {
    titel  = "Der Mobilmachungsbeschluss des Bundes"
    text {
        "Österreich beantragt im Bundestag die Mobilmachung der Bundestruppen gegen Preußen, das in"
        "Holstein eingerückt ist. Die Mehrheit stimmt zu; der preußische Gesandte erklärt den Bund für"
        "erloschen und verlässt den Saal. Zwischen Böhmen und Main stehen die Heere bereit."
    }
    datum  = 1866.06.14
    quelle = "Huber Bd. 3 (1963); Wawro, The Austro-Prussian War (1996)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    wer    = welt
    bedingung {
        welt_merkmal = preussischer_reformantrag
        datum >= 1866.05.15
        datum <= 1866.06.15
        staat PRU { im_krieg = nein }
        staat AUT { im_krieg = nein }
    }
    wartezeit = 10
    option krieg {
        text = "Krieg zwischen Preußen und Österreich"
        historisch = ja
        gewicht = 75
        wirkung { welt_merke = deutscher_krieg  staat PRU { krieg { gegner = AUT  fuehrung = ja } } }
    }
    option vermittlung {
        text = "Frankreich und Russland vermitteln, beide Mächte rüsten ab"
        gewicht = 20
        wirkung {
            welt_merke = dualismus
            staat PRU { beziehung_AUT = 10  zustimmung_militaer = -2 }
            chronik = "In dieser Geschichte bleibt der Krieg von 1866 aus; der Bund besteht weiter."
        }
    }
}

