ereignis kaiserproklamation {
    titel  = "Die Kaiserproklamation"
    text {
        "Im Spiegelsaal von Versailles wird König Wilhelm von Preußen zum Deutschen Kaiser ausgerufen, vor"
        "Fürsten und Offizieren, ohne Abgeordnete. Das Reich ist ein Bund der Fürsten und freien Städte mit"
        "dem Reichstag des Norddeutschen Bundes; Österreich steht draußen."
    }
    datum  = 1871.01.18
    quelle = "Nipperdey Bd. 2 (1992); Clark (2007)"
    sicherheit = ungeprueft
    art    = historisch
    wendepunkt = ja
    wer    = welt
    bedingung {
        staaten { wenn { merkmal = reichsbeitritt } mindestens = 3 }
        oder { welt_merkmal = kaiserbrief  datum >= 1871.03.01 }
        datum >= 1871.01.01
        datum <= 1871.06.30
    }
    wartezeit = 7
    option proklamieren {
        text = "Das Deutsche Reich wird ausgerufen"
        historisch = ja
        gewicht = 1
        wirkung { welt_merke = kaiserproklamation  staat PRU { zustimmung_nationalbewegung = 4 } }
    }
}
