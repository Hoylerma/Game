# Aufmarsch des Lesezeichens „Königgrätz“ (16. Juni 1866; Meilenstein M10b, Schritt b1).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.32; militaer.md, Abschnitt 6.1. Elbarmee, I. und
# II. Armee an der Grenze zu Sachsen und Böhmen, die Westarmee gegen Hannover und Kurhessen; die
# Nordarmee Benedeks bei Olmütz, ihr I. Korps mit den Sachsen in Nordböhmen; die süddeutschen
# Bundeskorps am Main. Ohne die Südarmee (Italien, nicht abgebildet). Stärken ungeprüft.

krieg deutscher_krieg {
    name        = "Deutscher Krieg"
    beginn      = 1866.06.16
    angreifer   = { PRU MSC MST OLD BWO DES WAL LIP LUE BRE HAM }
    verteidiger = { AUT SAX HAN BAV WUE BAD HED HEK NAS FRA SMG REA LIE }
    ziel        = { fuehrung = ja annexion = HAN annexion = HEK annexion = NAS annexion = FRA gebiet = au_holstein }
    ziel_verteidiger = { gebiet = pr_schlesien entschaedigung = 2 }
    quelle      = "Bundesbeschluss vom 14.6.1866 und Einmarsch am 16.6.; Ziele nach dem Prager Frieden (23.8.1866) und den Annexionen; österreichische Ziele Spielwert (Rückgewinn Schlesiens, Entschädigung)"
}

heer pru_elbarmee {
    staat        = PRU
    name         = "Elbarmee"
    befehlshaber = "Karl Eberhard Herwarth von Bittenfeld"
    fuehrung     = 1.1
    ort          = torgau
    soldaten     = 46000
    quelle = "Stärke und Ort nach Wissensstand ohne Quellenzugang (ungeprüft), Führung Spielwert (M10b)"
}

