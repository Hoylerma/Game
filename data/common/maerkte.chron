# Märkte (Meilenstein M5): ein Markt je Landschaft.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.14; Modell: docs/technik/wirtschaft.md,
# Abschnitte 2.4 und 4.1.
#   landschaften – Dateien in history/orte/ (ohne .chron), deren Orte zu diesem Markt gehören.
#                  Jede Landschaft gehört zu genau einem Markt.
#
# In M5 ist jede Landschaft ihr eigener Markt; das entspricht etwa der Größe der Handelsräume um
# Messeplätze, Häfen und Binnenzentren aus Kapitel 08, Abschnitt 5.1. Größere Handelsräume
# (Leipziger Messe, Hamburg, Frankfurt am Main) lassen sich später bilden, indem ein Markt mehrere
# Landschaften aufnimmt. Märkte ohne Orte mit Daten nehmen nicht teil.

markt anhalt {
    name         = "Anhalt (Dessau, Zerbst)"
    landschaften = { anhalt }
}

markt ardennen {
    name         = "Ardennen"
    landschaften = { ardennen }
}

