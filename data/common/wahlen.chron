# Regeln der Wahlsimulation (Meilenstein M8, docs/technik/politik.md Abschnitt 7).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.23. Alle Werte sind Spielwerte nach dem Entwurf;
# die Kalibrierung gegen die Fraktionsstärken der Nationalversammlung folgt in M8, Schritt a4
# (common/wahlziele_voelkerfruehling.chron). Neigungen je Strömung aus common/stroemungen.chron;
# fehlende Strömungen zählen 0.

wahlregeln {
    # 7.1 Wahlberechtigte: Männer ab 25 (Dreiklassen ab 24), dazu der Anteil „selbstständig“ je Beruf.
    maenneranteil       = 0.5
    junge_im_wahlalter  = 0.33     # Anteil der 15–29-Jährigen ab 25
    junge_ab_24         = 0.4      # Anteil der 15–29-Jährigen ab 24

    # 7.2 Beteiligung = basis + bildung × Alphabetisierung + stadt − not × (1 − Lebensstandard/100)
    beteiligung_basis   = 0.45
    beteiligung_bildung = 0.25
    beteiligung_stadt   = 0.1
    beteiligung_not     = 0.15
    beteiligung_min     = 0.15
    beteiligung_max     = 0.9

    # 7.3 Neigung: Interessengruppen, sonst die Grundneigung; dazu Bildung, Not, Stadt und Region.
    not_unter       = 40           # Lebensstandard, unter dem die Not die Neigung verschiebt (Pauperismus)
    neigung_basis   = { konservative = 0.35 katholiken = 0.15 liberale = 0.2 demokraten = 0.25 arbeiter = 0.05 }
    neigung_bildung = { konservative = -0.15 liberale = 0.1 demokraten = 0.05 }
    neigung_not     = { konservative = -0.1 liberale = -0.05 demokraten = 0.15 arbeiter = 0.1 }
    neigung_stadt   = { konservative = -0.08 katholiken = -0.04 liberale = 0.06 demokraten = 0.06 }

    # 7.4 Indirekte Wahl: Die Wahlmänner verschieben zu den Honoratioren.
    wahlmaenner     = { liberale = 1.15 katholiken = 1.15 }

    # 7.3 Rauschen je Wahlkreis und Strömung (±, relativ); 7.6 Abgeordnete.
    rauschen          = 0.05
    zug_zur_mitte     = 0.3
    position_rauschen = 15
    fraktionslos      = 0.25
}

# Regionen mit eigener Neigung (Abschnitt 7.3): Staaten (Tags zum Startdatum) oder Märkte.
region suedwesten {
    staaten = { BAD }
    maerkte = { kurpfalz }          # Pfalz
    neigung = { konservative = -0.1 demokraten = 0.12 liberale = 0.03 }
}

region wuerttemberg {
    staaten = { WUE }
    neigung = { konservative = -0.05 demokraten = 0.08 }
}

region sachsen {
    staaten = { SAX }
    neigung = { konservative = -0.05 demokraten = 0.1 }
}

region rheinland {
    maerkte = { rheinland niederrhein trier muensterland }
    neigung = { katholiken = 0.08 konservative = -0.05 }
}

region ostelbien {
    maerkte = { brandenburg pommern ostpreussen westpreussen mecklenburg posen }
    neigung = { konservative = 0.12 demokraten = -0.05 }
}
