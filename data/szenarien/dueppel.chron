# Kriegslesezeichen „Düppel“ (Meilenstein M10b, Schritt b1; docs/technik/militaer.md, Abschnitt 6.1).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.7. Am 1. Februar 1864 überschreiten Preußen und
# Österreich die Eider: Der Deutsch-Dänische Krieg beginnt (Ultimatum vom 16. Januar zur Rücknahme der
# Novemberverfassung). Aufmarsch und Kriegsziele: common/aufmarsch_dueppel.chron. Bevölkerung wie 1846
# (Entscheidung 14).

szenario dueppel {
    name     = "Düppel"
    datum    = 1864.02.01
    ende     = 1871.07.01   # seit M13a4: Urteil der Geschichte (vertical_slice.md 3.5)
    spieler  = PRU
    spielbar = { PRU AUT DEN }
    waehrung = "Taler"
    tragfaehigkeit_faktor = 2.5   # wie 1848 (keine Hochrechnung, Entscheidung 14)
    handel_eigenbedarf = ja       # seit M15a2 wie 1848 (wirtschaft.md 4.1)
    bauen = ja                    # seit M15b1: Gebäude in Landesteilen (bauen_und_anleitung.md 3)
}
