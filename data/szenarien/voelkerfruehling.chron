# Lesezeichen "Völkerfrühling" (Meilenstein M7).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.7.
# Am 1. März 1848 erreicht die Nachricht von der Februarrevolution in Paris
# (24. Februar) die deutschen Staaten; am 27. Februar hatte die Mannheimer
# Volksversammlung die "Märzforderungen" erhoben. Planung und Entscheidungen:
# docs/technik/lesezeichen_1848.md.

szenario voelkerfruehling {
    name     = "Völkerfrühling"
    datum    = 1848.03.01
    spieler  = PRU
    spielbar = { PRU AUT BAV SAX BAD }   # Entscheidung 3; alle anderen Staaten sind ebenfalls wählbar
    waehrung = "Taler"
    tragfaehigkeit_faktor = 2.5   # Agrartechnik 1848: Kartoffel, Klee, Agrarreformen (chronik-skript.md 3.7)
}
