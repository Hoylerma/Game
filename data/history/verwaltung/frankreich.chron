# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.

einheit fr_elsass {
    name   = "Elsass"
    art    = region
    quelle = "M10b-Recherche ohne Quellenzugang; Prüfung offen"
}

einheit fr_bas_rhin {
    name   = "Département Bas-Rhin"
    art    = departement
    ueber  = fr_elsass
    quelle = "Département 1846; für Moselle und Meurthe die heutigen Grenzen von Moselle und Meurthe-et-Moselle, die der Grenze von 1871 folgen (M10b, Wissensstand ohne Quellenzugang)"
}

