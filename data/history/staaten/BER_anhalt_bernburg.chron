# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Staat zum Lesezeichen "Der Westfälische Frieden" (24.10.1648), Testregion M1.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.5.
# schatz, hofhaltung, die Steuersätze (kontribution, akzise, zoll) und heer (Soldaten
# je 1.000 Einwohner) sind Spielwerte, skaliert auf die in der Testregion modellierten
# Orte dieses Staates – keine historischen Haushaltszahlen. Kalibrierung: data/README.md,
# Abschnitt "Wirtschaftswerte".
#
# Eine der vier anhaltischen Linien des Jahres 1648.

staat BER {
    name     = "Fürstentum Anhalt-Bernburg"
    kurzname = "Anhalt-Bernburg"
    farbe    = { 150 95 175 }
    quelle   = "Fürst 1630–1656 (Regententafel des Landesarchivs Sachsen-Anhalt). Anhalt seit der Zweiten Reformation (ab 1596) reformiert. Schatz, Steuersätze, Hofhaltung und Heer sind Spielwerte"

    1648.10.24 = {
        hauptstadt     = bernburg
        regierungsform = staendisches_fuerstentum
        herrscher      = "Christian II."
        konfession     = reformiert
        schatz         = 2000
        kontribution   = 0.10
        akzise         = 0.04
        zoll           = 0.03
        hofhaltung     = 2500
        heer           = 4
    }

    1806.04.18 = {
        name     = "Herzogtum Anhalt-Bernburg"
        kurzname = "Anhalt-Bernburg"
    }

    1834.03.24 = {
        herrscher = "Alexander Carl"
    }

    1848.03.01 = {
        hauptstadt     = ballenstedt
        regierungsform = absolute_monarchie
        konfession     = reformiert
        schatz         = 0
        kontribution   = 0.10
        akzise         = 0.05
        zoll           = 0.03
        hofhaltung     = 7400
        heer           = 6
        schulden       = 49000
        zollverein     = ja
    }
}
