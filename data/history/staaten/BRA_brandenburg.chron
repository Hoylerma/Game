# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Staat zum Lesezeichen "Der Westfälische Frieden" (24.10.1648), Testregion M1.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.5.
# schatz, hofhaltung, die Steuersätze (kontribution, akzise, zoll) und heer (Soldaten
# je 1.000 Einwohner) sind Spielwerte, skaliert auf die in der Testregion modellierten
# Orte dieses Staates – keine historischen Haushaltszahlen. Kalibrierung: data/README.md,
# Abschnitt "Wirtschaftswerte".
#
# Brandenburg 1648: Kurmark mit Altmark, Prignitz und Uckermark, Neumark, Herrschaft Cottbus,
# Halberstadt und Hinterpommern (rechtlich zugesprochen, faktisch bis 1653 schwedisch besetzt).
# Minden, Kleve-Mark-Ravensberg und das Herzogtum Preußen liegen außerhalb der Testregion.
# Regierungsform: Fürst mit Landständen (Landtagsrezess erst 1653; der Absolutismus folgt später).

staat BRA {
    name     = "Kurfürstentum Brandenburg"
    kurzname = "Brandenburg"
    farbe    = { 58 95 143 }
    quelle   = "Kurfürst seit 1640; Herrscherhaus reformiert seit Johann Sigismund (1613), Land lutherisch. IPO Art. XI: Hinterpommern, Stift Cammin, Halberstadt und Minden, Anwartschaft auf Magdeburg; Hinterpommern bis 1653 schwedisch besetzt. Kasse nach dem Krieg klamm: Schatz, Steuersätze, Hofhaltung und Heer sind Spielwerte"

    1648.10.24 = {
        hauptstadt     = berlin_coelln
        regierungsform = staendisches_fuerstentum
        herrscher      = "Friedrich Wilhelm"
        konfession     = reformiert
        schatz         = 23000
        kontribution   = 0.12
        akzise         = 0.04
        zoll           = 0.03
        hofhaltung     = 116000
        heer           = 12
    }
}
