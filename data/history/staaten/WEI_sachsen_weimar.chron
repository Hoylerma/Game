# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Staat zum Lesezeichen "Der Westfälische Frieden" (24.10.1648), Testregion M1.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.5.
# schatz, hofhaltung, die Steuersätze (kontribution, akzise, zoll) und heer (Soldaten
# je 1.000 Einwohner) sind Spielwerte, skaliert auf die in der Testregion modellierten
# Orte dieses Staates – keine historischen Haushaltszahlen. Kalibrierung: data/README.md,
# Abschnitt "Wirtschaftswerte".
#
# Ernestinisches Herzogtum (Weimar, Jena, Eisenach; Jena hier nicht eigens modelliert).

staat WEI {
    name     = "Herzogtum Sachsen-Weimar"
    kurzname = "Sachsen-Weimar"
    farbe    = { 80 80 190 }
    quelle   = "Herzog 1620–1662; nach der Teilung 1645 auch im Besitz der Stadt Eisenach mit der Wartburg. Schatz, Steuersätze, Hofhaltung und Heer sind Spielwerte"

    1648.10.24 = {
        hauptstadt     = weimar
        regierungsform = staendisches_fuerstentum
        herrscher      = "Wilhelm IV."
        konfession     = lutherisch
        schatz         = 4500
        kontribution   = 0.10
        akzise         = 0.04
        zoll           = 0.03
        hofhaltung     = 4000
        heer           = 4
    }

    1815.04.21 = {
        name     = "Großherzogtum Sachsen-Weimar-Eisenach"
        kurzname = "Sachsen-Weimar-Eisenach"
    }

    1828.06.14 = {
        herrscher = "Carl Friedrich"
    }

    1848.03.01 = {
        hauptstadt     = weimar
        regierungsform = konstitutionelle_monarchie
        konfession     = lutherisch
        schatz         = 0
        kontribution   = 0.10
        akzise         = 0.05
        zoll           = 0.03
        hofhaltung     = 35600
        heer           = 6
        schulden       = 237000
        zollverein     = ja
    }
}
