# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Staat zum Lesezeichen "Der Westfälische Frieden" (24.10.1648), Testregion M1.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.5.
# schatz, hofhaltung, die Steuersätze (kontribution, akzise, zoll) und heer (Soldaten
# je 1.000 Einwohner) sind Spielwerte, skaliert auf die in der Testregion modellierten
# Orte dieses Staates – keine historischen Haushaltszahlen. Kalibrierung: data/README.md,
# Abschnitt "Wirtschaftswerte".
#
# Königreich Böhmen in Personalunion mit den habsburgischen Erblanden; nur der Norden liegt in der
# Testregion (Randgebiet). Böhmen ist im Basisspiel Teil der Habsburger Fokus-Nation.

staat BOH {
    name     = "Königreich Böhmen"
    kurzname = "Böhmen"
    farbe    = { 175 175 185 }
    quelle   = "König von Böhmen und Kaiser (reg. 1637–1657). Verneuerte Landesordnung 1627: Erbkönigtum der Habsburger, nur katholisches Bekenntnis zugelassen. Lausitzen 1623 an Kursachsen verpfändet und mit dem Prager Frieden 1635 als Lehen abgetreten. Prag am Stichtag teilweise schwedisch besetzt. Hoher Steuerdruck der Kriegsjahre. Schatz, Steuersätze, Hofhaltung und Heer sind Spielwerte"

    1648.10.24 = {
        hauptstadt     = prag
        regierungsform = erbmonarchie
        herrscher      = "Ferdinand III."
        konfession     = katholisch
        schatz         = 32000
        kontribution   = 0.14
        akzise         = 0.06
        zoll           = 0.04
        hofhaltung     = 20500
        heer           = 10
    }
}
