# Schweriner Landesteil nach dem Fahrenholzer Vertrag (1621); Rostock (Kondominium) vereinfacht hier.

staat MSC {
    name     = "Herzogtum Mecklenburg-Schwerin"
    kurzname = "Mecklenburg-Schwerin"
    farbe    = { 215 95 65 }
    quelle   = "Herzog 1592–1658, 1648 zugleich Vormund des Güstrower Herzogs. IPO Art. XII: Verlust Wismars an Schweden, Entschädigung mit den Stiften Schwerin und Ratzeburg. Starke Ritterschaft, geringer Steuerzugriff. Schatz, Steuersatz und Hofhaltung sind Spielwerte"

    1648.10.24 = {
        hauptstadt     = schwerin
        regierungsform = staendisches_fuerstentum
        herrscher      = "Adolf Friedrich I."
        konfession     = lutherisch
        schatz         = 3000
        steuersatz     = 0.08
        hofhaltung     = 15500
    }
}
