#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.5.
# schatz, hofhaltung, die Steuersätze (kontribution, akzise, zoll) und heer (Soldaten
# je 1.000 Einwohner) sind Spielwerte, skaliert auf die in der Testregion modellierten
# Orte dieses Staates – keine historischen Haushaltszahlen. Kalibrierung: data/README.md,
# Abschnitt "Wirtschaftswerte".
#
# Schweriner Landesteil nach dem Fahrenholzer Vertrag (1621); Rostock (Kondominium) vereinfacht hier.

staat MSC {
    name     = "Herzogtum Mecklenburg-Schwerin"
    kurzname = "Mecklenburg-Schwerin"
    farbe    = { 215 95 65 }
    quelle   = "Herzog 1592–1658, 1648 zugleich Vormund des Güstrower Herzogs. IPO Art. XII: Verlust Wismars an Schweden, Entschädigung mit den Stiften Schwerin und Ratzeburg. Starke Ritterschaft, geringer Steuerzugriff. Schatz, Steuersätze, Hofhaltung und Heer sind Spielwerte"

    1648.10.24 = {
        hauptstadt     = schwerin
        regierungsform = staendisches_fuerstentum
        herrscher      = "Adolf Friedrich I."
        konfession     = lutherisch
        schatz         = 3000
        kontribution   = 0.08
        akzise         = 0.04
        zoll           = 0.04
        hofhaltung     = 5750
        heer           = 3
    }
}
