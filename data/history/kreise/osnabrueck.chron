# benannt nach dem größten Ort (heutige Einwohnerzahl). Räumlich gebildet, keine
# historischen Verwaltungseinheiten.

kreis kr_papenburg {
    name   = "Papenburg"
    quelle = "räumlich gebildet (M3), keine historische Verwaltungseinheit"
}

