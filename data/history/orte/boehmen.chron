# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Königreich Böhmen, nördlicher Teil (Randgebiet der Testregion) – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt bzw. ihrer Herrschaft (Umland).
#
# Nach der Verneuerten Landesordnung von 1627 war Böhmen habsburgisches
# Erbkönigtum, zugelassen war nur noch das katholische Bekenntnis. Viele
# Protestanten emigrierten (Exulanten, u. a. in die Oberlausitz); in Nordböhmen
# blieben bis über die Jahrhundertmitte zahlreiche Nichtkatholiken (vgl. das
# Untertanenverzeichnis nach dem Glauben von 1651). Die lutherischen Anteile
# sind Schätzungen. Im Sommer und Herbst 1648 operierten schwedische Truppen in
# Böhmen; Prag war am Stichtag teilweise besetzt.
#
# Ergänzt in Meilenstein M3 (tools/geodaten/orte.py): weitere Orte ohne Daten (ohne Historie) aus GeoNames, räumlich ausgewählt, Gelände aus dem Höhenmodell, Fläche aus der Karte.
# Umfang der Landschaft Böhmen: Königreich Böhmen (heute Tschechien westlich der Landesgrenze zu Mähren, Grenze nach heutigen Bezirken vereinfacht: Bezirke Havlíčkův Brod, Pelhřimov und Svitavy zu Böhmen).

ort prag {
    name     = "Prag"
    gelaende = flussaue
    lage     = { 14.42 50.09 }
    flaeche  = 191
    stadt    = ja
    kreis    = kr_prag
    quelle   = "Hauptstadt Böhmens. Seit 26.07.1648 Burg, Hradschin und Kleinseite von Schweden unter Königsmarck besetzt, Alt- und Neustadt belagert bis zur Friedensnachricht Anfang November; Abzug 1649. Jüdische Gemeinde um 1600 ca. 6.000 Menschen, Viertel 1627 erweitert (Encyclopaedia Judaica); Anteile und Gesamtbevölkerung Schätzung"

    1648.10.24 = {
        besitzer     = BOH
        bevoelkerung = 34000
        konfession   = { katholisch = 74 juedisch = 20 lutherisch = 6 }
        verwuestung  = 0.4
    }
}

