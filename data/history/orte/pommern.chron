# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Pommern – schwedisches Vorpommern und brandenburgisches Hinterpommern – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt (Umland); "bevoelkerung" umfasst beides.
#
# Nach dem Aussterben der Greifen (1637) teilte der Westfälische Frieden (IPO
# Art. X und XI) Pommern: Vorpommern mit Stettin, Rügen, Usedom und Wollin sowie
# einem Streifen östlich der Oder (Gartz, Damm, Gollnow) fiel als Reichslehen an
# Schweden, Hinterpommern und das säkularisierte Stift Cammin an Brandenburg.
# Hinterpommern blieb bis zum Stettiner Grenzrezess (Mai 1653, Übergabe Juni
# 1653) schwedisch besetzt; die Zuordnung zu Brandenburg folgt hier dem
# Rechtsstand des Friedens. Pommern war seit 1627 besetzt (zuerst kaiserlich,
# ab 1630 schwedisch), Kriegsschauplatz und Durchzugsgebiet und gehörte zu den
# am stärksten entvölkerten Ländern.

ort stettin {
    name     = "Stettin"
    gelaende = flussaue
    lage     = { 14.55 53.43 }
    flaeche  = 200
    stadt    = ja
    quelle   = "Seit 1630 schwedisch besetzt, 1648 an Schweden; Sitz der schwedischen Regierung in Pommern, Oderhandel. Bevölkerung Schätzung (Stadt mit Umland; Größenordnung nach Literatur zur Bevölkerungsentwicklung)"

    1648.10.24 = {
        besitzer     = SWE
        bevoelkerung = 7500
        konfession   = { lutherisch = 100 }
        verwuestung  = 0.4
    }
}

