    name         = "Stettin"
    besitzer     = SWE
    gelaende     = flussaue
    lage         = { 14.55 53.43 }
    flaeche      = 200
    bevoelkerung = 7500
    stadt        = ja
    konfession   = { lutherisch = 100 }
    verwuestung  = 0.4
    quelle       = "Seit 1630 schwedisch besetzt, 1648 an Schweden; Sitz der schwedischen Regierung in Pommern, Oderhandel. Bevölkerung Schätzung (Stadt mit Umland; Größenordnung nach Literatur zur Bevölkerungsentwicklung)"
}

