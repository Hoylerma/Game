# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Mittelrhein – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Mittelrhein mit Koblenz, Neuwied, Ahr, Hunsrück und unterer Mosel (1648 vor allem
# Kurtrier, Kurköln, Wied und Sayn).

ort kirchen {
    name     = "Kirchen"
    gelaende = huegelland
    lage     = { 7.8863 50.8085 }
    flaeche  = 132
    stadt    = nein
    kreis    = kr_kirchen
    quelle   = "GeoNames (CC BY 4.0), geonameid 2890586; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1848.03.01 = {
        besitzer = PRU
        bund     = ja
    }
}

