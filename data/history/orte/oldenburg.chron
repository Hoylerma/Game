    name     = "Wilhelmshaven"
    gelaende = kueste
    lage     = { 8.1125 53.53 }
    flaeche  = 119
    stadt    = ja
    kreis    = kr_wilhelmshaven
    quelle   = "GeoNames (CC BY 4.0), geonameid 2808720; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"
}

