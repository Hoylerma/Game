# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Göttingen – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Göttingen und Grubenhagen mit dem Untereichsfeld (heute Landkreise Göttingen und
# Northeim).

ort northeim {
    name     = "Northeim"
    gelaende = huegelland
    lage     = { 10 51.7066 }
    flaeche  = 195
    stadt    = ja
    kreis    = kr_northeim
    quelle   = "GeoNames (CC BY 4.0), geonameid 2861814; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1848.03.01 = {
        besitzer = HAN
        bund     = ja
    }
}

