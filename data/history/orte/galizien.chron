# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Westgalizien – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Polnischer Saum in Westgalizien (Auschwitz, Zator, Saybusch, Chrzanów; 1772–1918
# österreichisch).

ort jaworzno {
    name     = "Jaworzno"
    gelaende = huegelland
    lage     = { 19.275 50.2053 }
    flaeche  = 140
    stadt    = ja
    kreis    = kr_jaworzno
    quelle   = "GeoNames (CC BY 4.0), geonameid 3097333; heutiger Name nach GeoNames, kein abweichender deutscher Name belegt; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 20492
        konfession   = { katholisch = 88 juedisch = 12 }
        kultur       = { polen = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = AUT
        verwaltung = au_galizien
    }
}

