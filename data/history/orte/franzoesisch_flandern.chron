# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Französisch-Flandern – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Französisch-Flandern mit Dünkirchen, Lille und Douai sowie das Bergbaugebiet um Lens
# (Artois); im 17. Jahrhundert schrittweise von Frankreich erworben (Pyrenäenfrieden 1659,
# Aachen 1668, Nimwegen 1678).

ort duenkirchen {
    name     = "Dünkirchen"
    gelaende = kueste
    lage     = { 2.377 51.033 }
    flaeche  = 114
    stadt    = ja
    kreis    = kr_duenkirchen
    quelle   = "GeoNames (CC BY 4.0), geonameid 3020686; deutscher Name aus den GeoNames-Alternativnamen (heute Dunkerque); Gelände aus Höhenmodell; Fläche aus der Karte"
}

