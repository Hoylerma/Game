# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Thüringen – ernestinische Herzogtümer, kurmainzisches Erfurt und Eichsfeld, kursächsischer Thüringischer Kreis – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt (Umland); "bevoelkerung" umfasst beides.
#
# Die ernestinischen Lande waren 1640 unter Wilhelm (Weimar), Albrecht
# (Eisenach) und Ernst (Gotha) geteilt; nach Albrechts Tod (Dezember 1644) wurde
# Eisenach 1645 zwischen Weimar und Gotha aufgeteilt, die Stadt fiel an Weimar.
# Sachsen-Altenburg bildete eine eigene Linie (mit Anteilen am Coburg-Eisenacher
# Erbe von 1638; Coburg liegt außerhalb der modellierten Orte). Erfurt und
# das Eichsfeld unterstanden Kurmainz. Nicht modelliert sind u. a. die
# Reichsstädte Mühlhausen und Nordhausen sowie Schwarzburg, Reuß, Mansfeld,
# Stolberg und die Henneberger Lande.
#
# Ergänzt in Meilenstein M3 (tools/geodaten/orte.py): weitere Orte ohne Daten (ohne Historie)
# aus GeoNames, räumlich ausgewählt, Gelände aus dem Höhenmodell, Fläche aus der Karte.
# Umfang der Landschaft Thüringen: Thüringen mit dem kursächsischen Thüringischen Kreis (heute
# Thüringen, Burgenlandkreis und Mansfeld-Südharz).

ort erfurt {
    name     = "Erfurt"
    gelaende = boerde
    lage     = { 11.03 50.98 }
    flaeche  = 181
    stadt    = ja
    kreis    = kr_erfurt
    quelle   = "Kurmainzische Landstadt mit weitgehender Selbstverwaltung; schwedisch besetzt 1631–1635 und 1637–1650 (Stadtchronik Erfurt), Unterwerfung unter Kurmainz 1664. Katholische Minderheit um Domstift und Klöster, Anteil geschätzt. Bevölkerung Schätzung (Stadt mit Landgebiet)"

    1648.10.24 = {
        besitzer     = MAI
        bevoelkerung = 16000
        konfession   = { lutherisch = 85 katholisch = 15 }
        kultur       = { thueringer = 100 }
        verwuestung  = 0.4
    }

    1846.12.03 = {
        bevoelkerung = 46311
        konfession   = { lutherisch = 92 katholisch = 7 juedisch = 1 }
        kultur       = { thueringer = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = PRU
        verwaltung = pr_kr_erfurt
        bund       = ja
    }
}

