# Orte: Kurfürstentum Sachsen – Erblande (Meißnischer, Leipziger, Erzgebirgischer und Kurkreis) – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt (Umland); "bevoelkerung" umfasst beides.
#
# Kursachsen war nach dem Kriegseintritt (1631) und dem Prager Frieden (1635)
# wiederholt Kriegsschauplatz und blieb bis zum Nürnberger Exekutionstag
# teilweise schwedisch besetzt (Leipzig bis 1650). Die Verluste waren
# regional sehr unterschiedlich, insgesamt aber geringer als in Mecklenburg,
# Pommern oder der Mark. Lausitzer Orte stehen in lausitz.chron, Orte des
# Thüringischen Kreises in thueringen.chron, Jüterbog in magdeburg.chron.

ort dresden {
    name         = "Dresden"
    besitzer     = SAX
    gelaende     = flussaue
    lage         = { 13.74 51.05 }
    flaeche      = 220
    bevoelkerung = 15000
    stadt        = ja
    konfession   = { lutherisch = 100 }
    verwuestung  = 0.25
    quelle       = "Residenz und Festung des Kurfürsten Johann Georg I.; im Krieg nicht eingenommen. Bevölkerung Schätzung (Stadt mit Amt; Größenordnung nach Literatur zur Bevölkerungsentwicklung)"
}

