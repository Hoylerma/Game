# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Markgraftümer Ober- und Niederlausitz mit der brandenburgischen Herrschaft Cottbus – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt bzw. Weichbild (Umland).
#
# Beide Lausitzen kamen mit dem Prager Frieden 1635 (Traditionsrezess 1636)
# als böhmisches Lehen an Kursachsen; der Traditionsrezess sicherte den
# katholischen Stiften und Klöstern der Oberlausitz ihren Bestand. Cottbus war
# seit dem 15. Jahrhundert eine brandenburgische Exklave in der Niederlausitz.
# Die sorbische Bevölkerung ist im M1-Modell nicht gesondert abgebildet
# (Sprache/Volksgruppe folgt später). Die Oberlausitz nahm viele
# Glaubensflüchtlinge (Exulanten) aus Böhmen auf.

ort bautzen {
    name     = "Bautzen"
    gelaende = huegelland
    lage     = { 14.42 51.18 }
    flaeche  = 220
    stadt    = ja
    quelle   = "Hauptort der Oberlausitz und des Sechsstädtebundes. Katholische Minderheit um Domstift St. Petri (Simultankirche) und Klosterherrschaften, Anteil geschätzt. Bevölkerung Schätzung (Stadt mit Umland; Größenordnung nach Literatur zur Bevölkerungsentwicklung)"

    1648.10.24 = {
        besitzer     = SAX
        bevoelkerung = 7000
        konfession   = { lutherisch = 85 katholisch = 15 }
        verwuestung  = 0.5
    }
}

