# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Herzogtum Braunschweig-Wolfenbüttel (östlicher Teil) – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt (Umland); "bevoelkerung" umfasst beides.
#
# Herzog August der Jüngere regierte seit 1635; die Residenz Wolfenbüttel
# konnte er erst nach dem Abzug der kaiserlichen Besatzung 1643 beziehen. Die
# Stadt Braunschweig war formal landsässig, verwaltete sich aber faktisch
# selbst und wurde erst 1671 unterworfen. Weitere Landesteile (Weserraum,
# Harz) liegen außerhalb der Testregion bzw. sind nicht modelliert.
#
# Ergänzt in Meilenstein M3 (tools/geodaten/orte.py): weitere Orte ohne Daten (ohne Historie)
# aus GeoNames, räumlich ausgewählt, Gelände aus dem Höhenmodell, Fläche aus der Karte.
# Umfang der Landschaft Braunschweig: Herzogtum Braunschweig-Wolfenbüttel und Umgebung (heute
# Braunschweig, Wolfenbüttel, Salzgitter, Wolfsburg, Helmstedt, Peine, Goslar, Holzminden).

ort wolfenbuettel {
    name     = "Wolfenbüttel"
    gelaende = boerde
    lage     = { 10.53 52.16 }
    flaeche  = 193
    stadt    = ja
    kreis    = kr_wolfenbuettel
    quelle   = "Residenz und Festung, bis 1643 kaiserlich besetzt. Bevölkerung Schätzung (Stadt mit Amt; Größenordnung nach Literatur zur Bevölkerungsentwicklung). Verwüstung nach regionaler Kriegsbetroffenheit geschätzt"

    1648.10.24 = {
        besitzer     = BWO
        bevoelkerung = 6000
        konfession   = { lutherisch = 100 }
        kultur       = { niedersachsen = 100 }
        verwuestung  = 0.45
    }

    1848.03.01 = {
        besitzer = BWO
        bund     = ja
    }
}

