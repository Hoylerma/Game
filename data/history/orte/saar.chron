# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Saar – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Land an der Saar (heute Saarland; 1648 u. a. Nassau-Saarbrücken, Pfalz-Zweibrücken, Kurtrier und Lothringen).

ort sankt_wendel {
    name     = "Sankt Wendel"
    gelaende = huegelland
    lage     = { 7.1681 49.4663 }
    flaeche  = 118
    stadt    = ja
    kreis    = kr_sankt_wendel
    quelle   = "GeoNames (CC BY 4.0), geonameid 2841463; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"
}

