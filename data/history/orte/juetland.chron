# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Jütland – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Dänischer Saum nördlich der Königsau mit Kolding, Vejen, Esbjerg, Ribe und Fanø.

ort esbjerg {
    name     = "Esbjerg"
    gelaende = kueste
    lage     = { 8.4519 55.4703 }
    flaeche  = 282
    stadt    = ja
    kreis    = kr_esbjerg
    quelle   = "GeoNames (CC BY 4.0), geonameid 2622447; heutiger Name nach GeoNames, kein abweichender deutscher Name belegt; Gelände aus Höhenmodell; Fläche aus der Karte"
}

