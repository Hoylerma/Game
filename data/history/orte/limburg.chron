# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Limburg – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Niederländisch-Limburg (1839–1866 als Herzogtum Limburg im Deutschen Bund).

ort venlo {
    name     = "Venlo"
    gelaende = flussaue
    lage     = { 6.1681 51.37 }
    flaeche  = 160
    stadt    = ja
    kreis    = kr_venlo
    quelle   = "GeoNames (CC BY 4.0), geonameid 2745641; heutiger Name nach GeoNames, kein abweichender deutscher Name belegt; Gelände aus Höhenmodell; Fläche aus der Karte"

    1848.03.01 = {
        besitzer = NED
    }
}

