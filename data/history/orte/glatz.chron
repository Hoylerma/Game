# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Grafschaft Glatz – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Grafschaft Glatz (bis 1742 böhmisch, danach preußisch; heute Kreis Kłodzko).

ort glatz {
    name     = "Glatz"
    gelaende = huegelland
    lage     = { 16.6614 50.4349 }
    flaeche  = 164
    stadt    = ja
    kreis    = kr_glatz
    quelle   = "GeoNames (CC BY 4.0), geonameid 3096053; deutscher Name aus den GeoNames-Alternativnamen (heute Kłodzko); Gelände aus Höhenmodell; Fläche aus der Karte"

    1848.03.01 = {
        besitzer = PRU
        bund     = ja
    }
}

