# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Niederschlesien – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Niederschlesien mit Brieg und Namslau sowie Grünberg, Sagan und Neusalz.

ort gruenberg {
    name      = "Grünberg"
    gelaende  = huegelland
    lage      = { 15.5064 51.9355 }
    flaeche   = 227
    stadt     = ja
    kreis     = kr_gruenberg
    vorkommen = { weinlage }
    quelle    = "GeoNames (CC BY 4.0), geonameid 3080165; deutscher Name aus den GeoNames-Alternativnamen (heute Zielona Góra); Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 27254
        konfession   = { lutherisch = 65 katholisch = 34 juedisch = 1 }
        kultur       = { schlesier = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = PRU
        verwaltung = pr_kr_gruenberg
        bund       = ja
    }
}

