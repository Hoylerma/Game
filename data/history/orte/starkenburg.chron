# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Starkenburg – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Starkenburg, Bergstraße und Odenwald (heute Darmstadt, Offenbach und die
# südhessischen Landkreise).

ort offenbach {
    name     = "Offenbach"
    gelaende = flussaue
    lage     = { 8.7665 50.1006 }
    flaeche  = 78
    stadt    = ja
    kreis    = kr_offenbach
    quelle   = "GeoNames (CC BY 4.0), geonameid 2857807; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"
}

