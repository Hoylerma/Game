    quelle   = "GeoNames (CC BY 4.0), geonameid 2825422; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 9671
        konfession   = { lutherisch = 85 katholisch = 12 reformiert = 2 juedisch = 1 }
