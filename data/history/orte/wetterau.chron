# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Wetterau – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Wetterau und Untermain mit Frankfurt und Hanau (heute Frankfurt, Wetteraukreis,
# Main-Kinzig-Kreis und Hochtaunuskreis).

ort nidda {
    name     = "Nidda"
    gelaende = huegelland
    lage     = { 9.0064 50.4133 }
    flaeche  = 197
    stadt    = nein
    kreis    = kr_nidda
    quelle   = "GeoNames (CC BY 4.0), geonameid 2863716; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 15182
        konfession   = { lutherisch = 68 katholisch = 29 juedisch = 3 }
        kultur       = { hessen = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = HED
        verwaltung = hd_oberhessen
        bund       = ja
    }
}

