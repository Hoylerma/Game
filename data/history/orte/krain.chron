# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Krain – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Herzogtum Krain mit Laibach (heute Mittel-, Nordwest- und Südslowenien ohne das
# Küstenland).

ort assling_krain {
    name     = "Assling"
    gelaende = mittelgebirge
    lage     = { 14.0669 46.4306 }
    flaeche  = 267
    stadt    = nein
    kreis    = kr_assling_krain
    quelle   = "GeoNames (CC BY 4.0), geonameid 3198647; deutscher Name aus den GeoNames-Alternativnamen (heute Jesenice); Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 11783
        konfession   = { katholisch = 100 }
        kultur       = { slowenen = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = AUT
        verwaltung = au_krain
        bund       = ja
    }
}

