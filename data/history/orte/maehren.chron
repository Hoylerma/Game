# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Mähren – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Markgrafschaft Mähren (heute Tschechien östlich der Landesgrenze zu Böhmen ohne den
# schlesischen Teil; Grenze nach heutigen Bezirken vereinfacht).

ort maehrisch_schoenberg {
    name     = "Mährisch-Schönberg"
    gelaende = huegelland
    lage     = { 16.9706 49.9653 }
    flaeche  = 147
    stadt    = ja
    kreis    = kr_maehrisch_schoenberg
    quelle   = "GeoNames (CC BY 4.0), geonameid 3064673; deutscher Name aus den GeoNames-Alternativnamen (heute Šumperk); Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 15736
        konfession   = { katholisch = 95 juedisch = 3 lutherisch = 1 reformiert = 1 }
        kultur       = { tschechen = 70 deutschboehmen = 30 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = AUT
        verwaltung = au_kr_olmuetz
        bund       = ja
    }
}

