# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Burgundische Pforte – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Mömpelgard mit Héricourt (bis 1793 württembergisch) und der Nordrand der Freigrafschaft Burgund um Lure und Luxeuil.

ort moempelgard {
    name     = "Mömpelgard"
    gelaende = huegelland
    lage     = { 6.7982 47.5096 }
    flaeche  = 149
    stadt    = ja
    kreis    = kr_moempelgard
    quelle   = "GeoNames (CC BY 4.0), geonameid 2992938; deutscher Name aus den GeoNames-Alternativnamen (heute Montbéliard); Gelände aus Höhenmodell; Fläche aus der Karte"
}

