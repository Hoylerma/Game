# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Ardennen – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Französische Ardennen mit Charleville, Sedan und Givet.

ort charleville_mezieres {
    name     = "Charleville-Mézières"
    gelaende = huegelland
    lage     = { 4.7249 49.7685 }
    flaeche  = 266
    stadt    = ja
    kreis    = kr_charleville_mezieres
    quelle   = "GeoNames (CC BY 4.0), geonameid 3026613; heutiger Name nach GeoNames, kein abweichender deutscher Name belegt; Gelände aus Höhenmodell; Fläche aus der Karte"
}

