# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Oberhessen – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Oberhessen (heute Landkreise Gießen, Marburg-Biedenkopf und Vogelsberg).

ort marburg_an_der_lahn {
    name     = "Marburg an der Lahn"
    gelaende = huegelland
    lage     = { 8.7707 50.809 }
    flaeche  = 167
    stadt    = ja
    kreis    = kr_marburg_an_der_lahn
    quelle   = "GeoNames (CC BY 4.0), geonameid 2873759; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 19587
        konfession   = { reformiert = 55 lutherisch = 29 katholisch = 14 juedisch = 2 }
        kultur       = { hessen = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = HEK
        verwaltung = hk_oberhessen
        bund       = ja
    }
}

