# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Ostfriesland – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Ostfriesland (heute Landkreise Aurich, Leer, Wittmund und Emden).

ort wittmund {
    name     = "Wittmund"
    gelaende = flachland
    lage     = { 7.7784 53.5767 }
    flaeche  = 226
    stadt    = ja
    kreis    = kr_wittmund
    quelle   = "GeoNames (CC BY 4.0), geonameid 2807218; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 14008
        konfession   = { reformiert = 55 lutherisch = 43 juedisch = 2 }
        kultur       = { friesen = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = HAN
        verwaltung = hn_aurich
        bund       = ja
    }
}

