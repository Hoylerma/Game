# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Geldern – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Geldern mit Arnheim, Nimwegen und Zutphen sowie das Land van Cuijk (niederländischer
# Saum).

ort doetinchem {
    name     = "Doetinchem"
    gelaende = flachland
    lage     = { 6.2889 51.965 }
    flaeche  = 224
    stadt    = ja
    kreis    = kr_doetinchem
    quelle   = "GeoNames (CC BY 4.0), geonameid 2756767; heutiger Name nach GeoNames, kein abweichender deutscher Name belegt; Gelände aus Höhenmodell; Fläche aus der Karte"
}

