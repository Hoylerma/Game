# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Rheinhessen – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Rheinhessen und Nahe (heute Mainz, Worms, Alzey-Worms, Mainz-Bingen, Bad Kreuznach
# und Donnersbergkreis).

ort mainz {
    name     = "Mainz"
    gelaende = flussaue
    lage     = { 8.2791 49.9842 }
    flaeche  = 110
    stadt    = ja
    kreis    = kr_mainz
    quelle   = "GeoNames (CC BY 4.0), geonameid 2874225; Name nach GeoNames; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 49861
        konfession   = { katholisch = 50 lutherisch = 46 juedisch = 4 }
        kultur       = { pfaelzer = 100 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = HED
        verwaltung = hd_rheinhessen
        bund       = ja
    }
}

