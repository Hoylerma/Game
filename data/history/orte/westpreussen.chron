# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Westpreußen – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Pommerellen, Kulmer Land, Marienburg und Elbing (1466–1772 Preußen Königlichen
# Anteils, danach bis 1920 preußisch).

ort gniewino {
    name     = "Gniewino"
    gelaende = huegelland
    lage     = { 18.0166 54.7171 }
    flaeche  = 198
    stadt    = nein
    kreis    = kr_gniewino
    quelle   = "GeoNames (CC BY 4.0), geonameid 3099125; heutiger Name nach GeoNames, kein abweichender deutscher Name belegt; Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 6713
        konfession   = { lutherisch = 95 katholisch = 3 juedisch = 2 }
        kultur       = { polen = 50 altpreussen = 35 kaschuben = 15 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = PRU
        verwaltung = pr_preussen
    }
}

