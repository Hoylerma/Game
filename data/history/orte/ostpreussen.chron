# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Ostpreußen – Orte ohne Daten (Meilenstein M3).
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Erzeugt von tools/geodaten/orte.py aus GeoNames cities1000 (CC BY 4.0): räumlich
# ausgewählte Orte mit deutschem Namen, wo GeoNames ihn führt, Gelände aus dem Höhenmodell
# und Fläche aus der Karte. Noch ohne Historie (Besitz, Bevölkerung).
#
# Umfang: Herzogtum Preußen mit Ermland (bis 1772 polnisch) und Memelland (heute Woiwodschaft
# Ermland-Masuren, Oblast Kaliningrad und der Westen Litauens um Klaipėda).

ort memel {
    name     = "Memel"
    gelaende = kueste
    lage     = { 21.1391 55.7068 }
    flaeche  = 331
    stadt    = ja
    kreis    = kr_memel
    quelle   = "GeoNames (CC BY 4.0), geonameid 598098; deutscher Name aus den GeoNames-Alternativnamen (heute Klaipėda); Gelände aus Höhenmodell; Fläche aus der Karte"

    1846.12.03 = {
        bevoelkerung = 19099
        konfession   = { lutherisch = 85 katholisch = 13 juedisch = 2 }
        kultur       = { altpreussen = 80 litauer = 10 masuren = 10 }
        verwuestung  = 0
    }

    1848.03.01 = {
        besitzer   = PRU
        verwaltung = pr_kr_memel
    }
}

