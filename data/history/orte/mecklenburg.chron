    name     = "Güstrow"
    gelaende = flachland
    lage     = { 12.18 53.79 }
    flaeche  = 250
    stadt    = ja
    quelle   = "Residenz des Güstrower Landesteils. Bevölkerung Schätzung (Stadt mit Amt; Größenordnung nach Literatur zur Bevölkerungsentwicklung). Verwüstung nach regionaler Kriegsbetroffenheit geschätzt"

    1648.10.24 = {
        besitzer     = MGU
