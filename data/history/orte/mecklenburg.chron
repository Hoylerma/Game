# Orte: Herzogtümer Mecklenburg-Schwerin und Mecklenburg-Güstrow mit dem schwedischen Wismar – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt (Umland); "bevoelkerung" umfasst beides.
#
# Grundlage der Aufteilung ist der Fahrenholzer Vertrag (1621): Schwerin erhielt
# u. a. Schwerin, Parchim, Waren und Wismar, Güstrow u. a. Güstrow und
# Neubrandenburg mit dem Land Stargard. Rostock mit Warnemünde blieb
# Kondominium beider Herzöge. Der Güstrower Herzog Gustav Adolf (geb. 1633)
# stand bis 1654 unter Vormundschaft Adolf Friedrichs I. von Schwerin.
# Mecklenburg verlor im Krieg einen sehr großen Teil seiner Bevölkerung.

ort schwerin {
    name         = "Schwerin"
    besitzer     = MSC
    gelaende     = seenplatte
    lage         = { 11.41 53.63 }
    flaeche      = 250
    bevoelkerung = 4200
    stadt        = ja
    konfession   = { lutherisch = 100 }
    verwuestung  = 0.6
    quelle       = "Residenz Herzog Adolf Friedrichs I. Bevölkerung Schätzung (Stadt mit Amt; Größenordnung nach Literatur zur Bevölkerungsentwicklung). Verwüstung nach regionaler Kriegsbetroffenheit geschätzt"
}

ort wismar {
    name         = "Wismar"
