# Erzeugt von tools/archivar aus data/tabellen/ – nicht von Hand bearbeiten.
#
# Orte: Herzogtümer Mecklenburg-Schwerin und Mecklenburg-Güstrow mit dem schwedischen Wismar – Stand 24.10.1648.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 3.6.
# Ein Ort steht für eine Stadt mit ihrem Amt (Umland); "bevoelkerung" umfasst beides.
#
# Grundlage der Aufteilung ist der Fahrenholzer Vertrag (1621): Schwerin erhielt
# u. a. Schwerin, Parchim, Waren und Wismar, Güstrow u. a. Güstrow und
# Neubrandenburg mit dem Land Stargard. Rostock mit Warnemünde blieb
# Kondominium beider Herzöge. Der Güstrower Herzog Gustav Adolf (geb. 1633)
# stand bis 1654 unter Vormundschaft Adolf Friedrichs I. von Schwerin.
# Mecklenburg verlor im Krieg einen sehr großen Teil seiner Bevölkerung.

ort schwerin {
    name     = "Schwerin"
    gelaende = seenplatte
    lage     = { 11.41 53.63 }
    flaeche  = 250
    stadt    = ja
    quelle   = "Residenz Herzog Adolf Friedrichs I. Bevölkerung Schätzung (Stadt mit Amt; Größenordnung nach Literatur zur Bevölkerungsentwicklung). Verwüstung nach regionaler Kriegsbetroffenheit geschätzt"

    1648.10.24 = {
        besitzer     = MSC
        bevoelkerung = 4200
        konfession   = { lutherisch = 100 }
        verwuestung  = 0.6
    }
}

ort wismar {
    name     = "Wismar"
    gelaende = kueste
    lage     = { 11.46 53.89 }
    flaeche  = 150
    stadt    = ja
    quelle   = "IPO Art. X: Stadt und Hafen Wismar mit Poel und Neukloster an Schweden (Reichslehen); schwedische Festung. Bevölkerung Schätzung (Größenordnung nach Literatur zur Bevölkerungsentwicklung)"

    1648.10.24 = {
        besitzer     = SWE
        bevoelkerung = 6000
        konfession   = { lutherisch = 100 }
        verwuestung  = 0.45
    }
}

ort rostock {
    name     = "Rostock"
    gelaende = kueste
    lage     = { 12.14 54.09 }
    flaeche  = 200
    stadt    = ja
    quelle   = "Hansestadt und Universität; nach dem Fahrenholzer Vertrag (1621) Kondominium beider Herzöge, hier vereinfacht Mecklenburg-Schwerin zugeordnet (Adolf Friedrich I. führte 1648 auch die Güstrower Vormundschaft); Seezoll in Warnemünde in schwedischer Hand. Bevölkerung Schätzung"

    1648.10.24 = {
        besitzer     = MSC
        bevoelkerung = 7500
        konfession   = { lutherisch = 100 }
        verwuestung  = 0.45
    }
}

