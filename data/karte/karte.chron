# Karte des Kernraums (Meilenstein M3): Ausschnitt, Projektion und Bildgröße.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 6.1.
# Eingabe für tools/geodaten/geodaten.py (Zuschnitt der Geometrie in geometrie/) und für
# tools/kartengenerator/kartengenerator.py, der daraus provinzen.png, fluesse.png und
# definition.csv in diesem Ordner erzeugt (nicht von Hand bearbeiten).
#
# Ausschnitt: 1,8–23,5 °O × 45,1–56,2 °N. Der Kernraum (geometrie/kernraum.geojson) reicht von
# Französisch-Flandern (Dünkirchen, etwa 2,3 °O) bis an die Ostgrenze Ostpreußens (Schirwindt,
# etwa 22,9 °O) und von Krain (Kulpa, etwa 45,4 °N) bis zum Memelland (Nimmersatt, etwa 55,9 °N);
# ringsum bleiben 20–40 km Rand für Meer und Ausland.
#
# Projektion: Plattkarte mit Bezugsbreite 51 °N. Seitenverhältnis nach Abschnitt 6.1:
# 21,7 × cos(51°) / 11,1 = 1,2303; 4096 / 3329 = 1,2304 (Abweichung 0,01 %).
# Ein Pixel ist damit etwa 0,37 km × 0,37 km groß (bei 51 °N).
#
# Die Küstenlinie des Meilensteins M1 (Feld kueste) entfällt: Land, Meer, Seen und Flüsse kommen
# aus geometrie/*.geojson (erzeugt mit tools/geodaten aus Natural Earth).
#
# max_radius_km: Die Orte stammen aus GeoNames cities1000 (Siedlungen ab 1.000 Einwohnern). Im Osten
# Ostpreußens (heute Oblast Kaliningrad) und im Memelland führt diese Quelle nur wenige Orte; dort
# liegt Kernraum-Land bis 27 km vom nächsten Ort entfernt. Im übrigen Kernraum sind es höchstens
# 25 km, mehr als 20 km nur in wenigen Randgebieten (etwa an der Biebrza und an der Maas). 32 km
# lassen Raum für die Verschiebung durch das Rauschen des Kartengenerators, damit dieses Land Orten
# zugeordnet wird, statt leer zu bleiben (tools/geodaten/orte.py, README „Orte des Kernraums“).

karte {
    bild_breite   = 4096
    bild_hoehe    = 3329
    laenge_min    = 1.8      # Grad Ost, linker Bildrand
    laenge_max    = 23.5
    breite_min    = 45.1     # Grad Nord, unterer Bildrand
    breite_max    = 56.2
    bezugsbreite  = 51.0     # Grad Nord, siehe Projektion
    max_radius_km = 32       # weiter entfernte Pixel gehören zu keinem Ort (Begründung oben)
}
