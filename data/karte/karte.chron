# Karte der Testregion (Meilenstein M1): Projektion, Bildgröße und Küstenlinie.
#
# Format: docs/technik/chronik-skript.md, Abschnitt 6.1.
# Eingabe für tools/kartengenerator/kartengenerator.py, der daraus provinzen.png und
# definition.csv in diesem Ordner erzeugt (nicht von Hand bearbeiten).
#
# Projektion: equirektangular (Länge und Breite linear) im Rechteck
# 9,5–16,5 °O × 50,0–54,8 °N. Bei 52,4 °N sind die Pixel nahezu quadratisch
# (je etwa 0,46 km × 0,46 km).
#
# Küste: Linienzug der Ostseeküste von West nach Ost (Länge Breite, WGS84, auf etwa
# 0,01° gerundet nach realen Orten); nördlich davon ist Meer. Der Kartengenerator
# interpoliert die Breite linear zwischen den Punkten, die Längengrade müssen daher
# streng steigen. Vereinfachungen:
# - Inseln (Fehmarn, Poel, Rügen, Hiddensee) fehlen und sind Meer; Usedom und Wollin
#   werden mit ihrer Außenküste als Land geführt, das Stettiner Haff und der
#   Peenestrom sind dadurch ebenfalls Land.
# - Förden, Bodden und Buchten, die nach Westen zurückgreifen (Eckernförder Bucht,
#   Kieler Förde, Salzhaff, Saaler Bodden), sind nur angedeutet oder fehlen.
# - Das östliche Wagrien (Oldenburg in Holstein, Grömitz) liegt hinter der
#   vereinfachten Westküste der Lübecker Bucht und erscheint als Meer; dort liegt
#   kein Ort der Testregion.

karte {
    bild_breite   = 1024
    bild_hoehe    = 1152
    laenge_min    = 9.5      # Grad Ost, linker Bildrand
    laenge_max    = 16.5
    breite_min    = 50.0     # Grad Nord, unterer Bildrand
    breite_max    = 54.8
    max_radius_km = 42       # weiter entfernte Punkte gehören zu keinem Ort

    kueste = {
        # Schleswig-Holstein (ohne Orte der Testregion)
        9.50 54.83      # Flensburger Förde, Südufer
        9.70 54.81      # Langballig
        9.90 54.76      # Geltinger Bucht
        10.00 54.68     # Schleimünde
        10.03 54.56     # Damp
        10.10 54.47     # Dänischer Wohld (Eckernförder Bucht vereinfacht)
        10.19 54.43     # Mündung der Kieler Förde
        10.30 54.43     # Laboe
        10.45 54.41     # Probstei
        10.60 54.36
        10.70 54.32     # Hohwachter Bucht
