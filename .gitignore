# ── Build-Ausgaben (C++/CMake) ──────────────────────────────
/build/
/build-*/
/out/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json

# ── Godot ──────────────────────────────────────────────────
# Importcache und Editor-Zustand werden lokal erzeugt.
/game/.godot/
# export_presets.cfg ist seit M13b5 eingecheckt (Pakete, vertical_slice.md 7); Exporte landen in build/.
# Musik und Bedienklänge (seit M13b2): von tools/klang/klang.py erzeugt, nicht versioniert.
/game/audio/musik/
/game/audio/klaenge/
# Kompilierte GDExtension-Bibliotheken werden vom Build in game/bin/ kopiert.
/game/bin/*.so
/game/bin/*.dll
/game/bin/*.dylib
/game/bin/*.framework/
/game/bin/*.pdb
/game/bin/*.exp
/game/bin/*.lib

# ── Lokale Werkzeuge und Laufzeitdaten ─────────────────────
/tools/godot/
/saves/
*.log

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── IDEs und Betriebssysteme ───────────────────────────────
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Rohdaten des Spieltests (seit M13b6): Fragebögen, Rückmeldungen, Spielstände, Protokolle. Eingecheckt
# wird nur die Auswertung (docs/pruefung/spieltest_m13_ergebnisse.md).
/spieltest/
