# La Marseillaise – Claude Joseph Rouget de Lisle (1792), gemeinfrei. Melodie nach dem Erstdruck
# Bignon 1792, geprüft am Notensatz des Mutopia-Projekts (Coyau, gemeinfrei). Im Februar 1848 das
# Lied der Pariser Revolution, das in den deutschen Staaten gesungen und verboten wurde.
# Satz für EINIGKEIT: Melodie im Blech, dann mit Holzbläsern; Bass (Grundton und Quinte) und Trommel
# sind eigene Zutaten.

titel     = "La Marseillaise"
komponist = "Claude Joseph Rouget de Lisle"
werk      = "Chant de guerre pour l'armée du Rhin (1792)"
stimmung  = revolution
tempo     = 96
takt      = 4/4
hall      = 0.32

stimme melodie { instrument = blech      lautstaerke = 0.55 }
stimme holz    { instrument = holz       lautstaerke = 0.5 }
stimme bass    { instrument = streicher  lautstaerke = 0.55 }
stimme trommel { instrument = trommel    lautstaerke = 0.18 }

teil auftakt {
    melodie = "r:8 r:16 g4 e4:8. g4:16 |"
}

teil a {
    melodie = "c5:4 c5 d5 d5 | g5:4. f5:8 e5 r:16 c5 e5:8. c5:16 | a4:4 f5:2 d5:8. h4:16 | c5:2 r:4 c5:8. d5:16 |"
