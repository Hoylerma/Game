    melodie    = "d5:2 r:8 |"
    begleitung = "r:8 | d3 fis3 a3 d3 g3 h3 | d3 fis3 a3 g2 h2 e3 | a2 d3 a3 a2 e3 cis3 |"
    begleitung = "d3:8 fis3 a3 d3 fis3 a3 | d3 fis3 a3 d3 g3 h3 | d3 fis3 a3 g2 h2 e3 | a2 d3 a3 a2 e3 cis3 |"
    begleitung = "[fis3 d3]:8 a2 d3 d2 r r | a2 e3 a3 cis3 a3 e3 | d3 fis3 h3 d3 fis3 d3 | e3 a3 e3 e3 h3 e3 |"
    begleitung = "[e3 a2]:2. | d2:8 fis2 a2 d2 g2 h2 | d3 fis3 a3 g2 h2 g2 | a2 d3 fis3 a2 e3 a2 |"
    begleitung = "d3:8 a2 fis2 d2 r |"
}

