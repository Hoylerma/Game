# Die Loreley („Ich weiß nicht, was soll es bedeuten“) – Friedrich Silcher (um 1837) nach Heinrich
# Heine (1823), gemeinfrei. Melodie und Begleitung geprüft am Notensatz des Mutopia-Projekts
# (Stan Sanderson, gemeinfrei). Satz für EINIGKEIT: Melodie in den Holzbläsern, dann in den
# Streichern, Begleitung im Klavier.

titel     = "Die Loreley"
komponist = "Friedrich Silcher"
werk      = "Volksweise nach Heinrich Heine (um 1837)"
stimmung  = "frieden krise"
tempo     = 72
takt      = 6/8
hall      = 0.3

stimme melodie    { instrument = holz       lautstaerke = 0.75 }
stimme streicher  { instrument = streicher  lautstaerke = 0.6 }
stimme begleitung { instrument = klavier    lautstaerke = 0.5 }

teil a {
    melodie    = "a4:8 | a4:8. h4:16 a4:8 d5 cis5 h4 | a4:4. g4:4 g4:8 | fis4:4 fis4:8 e4 d4 e4 |"
    melodie    = "fis4:2 r:8 a4 | a4:8. h4:16 a4:8 d5 cis5 h4 | a4:4. g4:4 g4:8 | fis4:4 fis4:8 a4 g4 e4 |"
