[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/top_bar.gd" id="1_bar"]
[ext_resource type="Script" path="res://scripts/ui/coat_of_arms.gd" id="2_coat"]

[node name="TopBar" type="PanelContainer"]
custom_minimum_size = Vector2(0, 62)
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 62.0
grow_horizontal = 2
theme_type_variation = &"TopBarPanel"
script = ExtResource("1_bar")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Coat" type="Control" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 38)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("2_coat")

[node name="StateBox" type="VBoxContainer" parent="Row"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="StateName" type="Label" parent="Row/StateBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"NameLabel"
text = "Keine Simulation"
text_overrun_behavior = 3

[node name="StateDetail" type="Label" parent="Row/StateBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Spielerstaat unbekannt"
text_overrun_behavior = 3

[node name="Separator1" type="VSeparator" parent="Row"]
layout_mode = 2

