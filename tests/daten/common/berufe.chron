# Testdaten: Berufsgruppen. Summe anteil_stadt = 1, Summe anteil_land = 1.
beruf bauern {
    name            = "Bauern"
    schicht         = unten
    ertrag          = 6
    steuerpflichtig = ja
    anteil_stadt    = 0.10
    anteil_land     = 0.80
}

beruf handwerker {
    name            = "Handwerker"
    schicht         = mittel
    ertrag          = 12
    steuerpflichtig = ja
    anteil_stadt    = 0.50
    anteil_land     = 0.15
}

beruf kaufleute {
    name            = "Kaufleute"
