# Testdaten: Berufsgruppen. Summe anteil_stadt = 1, Summe anteil_land = 1.
beruf bauern {
    name            = "Bauern"
    schicht         = unten
    steuerpflichtig = ja
    anteil_stadt    = 0.10
    anteil_land     = 0.80
    agrar           = ja
    bildung         = 0.1
    in_stadt        = handwerker
}

beruf handwerker {
    name            = "Handwerker"
    schicht         = mittel
    steuerpflichtig = ja
    anteil_stadt    = 0.50
    anteil_land     = 0.15
    agrar           = nein
    bildung         = 0.3
}

beruf kaufleute {
    name            = "Kaufleute"
    schicht         = oben
    steuerpflichtig = yes
    anteil_stadt    = 0.30
    anteil_land     = 0          # auf dem Land keine Kaufleute → kein Block
    agrar           = nein
    bildung         = 0.6
}

beruf adel {
    name            = "Adel"
    schicht         = oben
    steuerpflichtig = nein       # privilegiert
    anteil_stadt    = 0.10
    anteil_land     = 0.05
    agrar           = nein
    bildung         = 0.8
    agrarabgabe     = 0.3        # seit M5
}
